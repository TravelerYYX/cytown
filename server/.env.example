# 复制为同目录下的 .env 后按需修改（application.yml 通过 spring.config.import 加载）。
# 注意：等号后不要加引号（按 properties 格式解析）；OS 环境变量优先级高于本文件。

# 服务端口
SERVER_PORT=8080

# MySQL 8
DB_URL=jdbc:mysql://127.0.0.1:3306/ciyuantown?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change_me

# Redis（REDIS_ENABLED=false 时完全不依赖 Redis）
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT 签名密钥，生产环境请替换为足够长的随机串
JWT_SECRET=please-change-this-to-a-long-random-secret

# 媒体 / 会员配置加密密钥（AES，任意长随机串）
CHAT_MEDIA_KEY=please-change-this-too
MEDIA_CONFIG_KEY=please-change-this-too
MEMBERSHIP_CONFIG_KEY=please-change-this-too

# 邮箱验证码服务（QQ 邮箱 SMTP 示例）
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# 上传文件根目录
UPLOAD_DIR=./uploads

# ffmpeg / ffprobe（Linux 通常为 /usr/bin/ffmpeg，未安装可留空）
FFMPEG_PATH=
FFPROBE_PATH=
FFMPEG_FONT_PATH=

# 第三方 IP 定位服务
IP_LOCATE_KEY=
