# 开发环境默认指向本机后端（端口见 server/src/main/resources/application.yml）。
VITE_API_BASE_URL=http://127.0.0.1:8080


# Android 真机开发走 USB 隧道：npm run connect:usb 建立 adb reverse，
# 手机侧 127.0.0.1:18080 -> 电脑 8080，不依赖 Wi-Fi 局域网（该链路会间歇性不可达）。
# 端口由本文件决定，scripts/connect-android-usb.cjs 会自动读取并保持一致。
# USB 拔插或 ADB 重启后隧道失效，重新执行 npm run connect:usb 即可。
VITE_ANDROID_DEV_API_BASE_URL=http://127.0.0.1:18080


# 备选：局域网直连（仅在不用 USB 隧道时手动切换）。
# 电脑局域网 IP 会随网卡变化，切换前先确认，并同步后端 CORS 白名单（CORS_ORIGINS）。
# VITE_ANDROID_DEV_API_BASE_URL=http://192.168.1.10:8080

# IP 定位接口密钥：请写入 .env.local（已 gitignore，不入库），
# 形如 IP_LOCATE_KEY=ipl_xxxx；由 Vite 开发代理在服务端注入，不会打进前端包。
# 注意：不要在此文件重复定义该变量，否则会覆盖 .env.local 中的值（vite 按 .env → .env.local → .env.development 顺序合并）。
