export interface CheckinAsset {url:string;originalBytes:number;processedBytes:number}
export interface CheckinFrame {id:string;name:string;image:CheckinAsset}
export interface CheckinDay {day:number;coins:number;experience:number;frameId:string;frameDays:number;primary:string}
export interface CheckinConfig {version:number;makeupPrice:number;coinIcon:CheckinAsset;experienceIcon:CheckinAsset;frames:CheckinFrame[];days:CheckinDay[]}
export interface CheckinDayView {day:number;reward:CheckinDay;signed:boolean;makeup:boolean;today:boolean;canMakeup:boolean}
export interface CheckinState {today:string;month:string;daysInMonth:number;signedDays:number;missedDays:number;balance:number;makeupPrice:number;signedToday:boolean;days:CheckinDayView[];config:CheckinConfig}
export interface OwnedFrame {frameId:string;expiresAt:number|null}
export interface CheckinRecommendation {id:string;title:string;excerpt:string;coverUrl:string}
