const normalize = (value?: string) => value?.trim().replace(/\/+$/, '') || ''
const isAndroidApp = () => {
  try { return uni.getSystemInfoSync().platform === 'android' } catch { return false }
}

let configured = normalize(import.meta.env.VITE_API_BASE_URL)
let usbTunnel = false
// #ifdef APP
// Android 开发基座优先走 adb reverse 建立的 USB 隧道（npm run connect:usb）；
// H5、iOS 与生产构建使用常规地址。
if (import.meta.env.MODE === 'development' && isAndroidApp()) {
  const tunnel = normalize(import.meta.env.VITE_ANDROID_DEV_API_BASE_URL)
  if (tunnel) {
    configured = tunnel
    usbTunnel = true
  }
}
// #endif
if (!configured) throw new Error('缺少 VITE_API_BASE_URL，请配置后端 API 地址')
if (import.meta.env.MODE === 'production' && !configured.startsWith('https://')) throw new Error('生产 API 地址必须使用 HTTPS')
export const API_BASE_URL = configured
// Android 开发基座经 USB 隧道访问电脑后端时为 true，用于给出针对性的连接失败提示。
export const ANDROID_USB_TUNNEL = usbTunnel
if (import.meta.env.DEV && usbTunnel) console.info('[env] Android USB 隧道后端地址', configured)
