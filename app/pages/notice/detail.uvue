<template><view class="detail-page" :class="[uxNative?'ux0':'',uxNative?'ux1':'']"><view class="page-header" :style="{paddingTop:statusBarHeight+'px'}" :class="[uxNative?'ux0':'',uxNative?'ux2':'']"><ActionButton :aria-label="&quot;返回&quot;" @tap="back" :class="[uxNative?'ux3':'',uxNative?'ux4':'']"><AppIcon name="back" :size="40" /></ActionButton><text :class="[uxNative?'ux5':'',uxNative?'ux6':'',uxNative?'ux7':'']">通知详情</text><view  :class="[uxNative?'ux0':'',uxNative?'ux8':'']"/></view><scroll-view class="detail-scroll" direction="vertical" :show-scrollbar="false" :class="[uxNative?'ux9':'',uxNative?'ux10':'']"><view v-if="loading" class="load-tip" :class="[uxNative?'ux0':'',uxNative?'ux11':'']"><text :class="[uxNative?'ux5':'',uxNative?'ux12':'',uxNative?'ux6':'']">通知加载中…</text></view><view v-else-if="error" class="load-tip" :class="[uxNative?'ux0':'',uxNative?'ux11':'']"><text :class="[uxNative?'ux5':'',uxNative?'ux12':'',uxNative?'ux6':'']">{{error}}</text></view><view v-else-if="notice" class="article" :class="[uxNative?'ux13':'']"><text class="title" :class="[uxNative?'ux5':'',uxNative?'ux6':'',uxNative?'ux14':'']">{{notice!.title}}</text><text class="time" :class="[uxNative?'ux5':'',uxNative?'ux6':'',uxNative?'ux15':'']">{{notice!.publishTime}}</text><view class="blocks" :class="[uxNative?'ux0':'',uxNative?'ux16':'']"><template v-for="(block,index) in notice!.blocks" :key="index"><text v-if="block.type==='text'" class="paragraph" :class="[uxNative?'ux5':'',uxNative?'ux6':'',uxNative?'ux17':'']">{{block.text}}</text><image v-else class="content-image" :src="uiAsset(resourceUrl(block.url))" mode="widthFix"  :class="[uxNative?'ux18':'']"/></template></view><ActionButton :aria-label="&quot;查看相关帖子&quot;" v-if="notice!.postId" class="post-link" @tap="post" :class="[uxNative?'ux3':'',uxNative?'ux19':'']"><text :class="[uxNative?'ux5':'',uxNative?'ux20':'',uxNative?'ux6':'']">查看相关帖子</text></ActionButton></view></scroll-view><EyeCareOverlay /></view></template>
<script setup lang="uts">
import { uiAsset } from '@/utils/ui-assets'
import ActionButton from '@/components/ActionButton.uvue'

import { notifyWindowResize } from '@/utils/window-events'
onResize(notifyWindowResize)

import { uxNative, uxClass, uxMedia } from '@/utils/native-styles';

import { mediaUrl as resourceUrl } from '@/utils/media-cache'
import {authRevision,getUserInfo} from '@/utils/auth';import {readNoticeOne} from '@/utils/notice-state';import {ref,watch} from 'vue';import AppIcon from '@/components/AppIcon.uvue';import {useWindowInsets} from '@/composables/useWindowInsets';import {fetchNoticeDetail} from '@/utils/notice-api';import {API_BASE_URL} from '@/config/env';import type {NoticeDetail} from '@/types/home';const {statusBarHeight}=useWindowInsets();const notice=ref<NoticeDetail>(),loading=ref(true),error=ref('');let id=0,fromPush=false;onLoad(q=>{id=Number(q?.id||0);fromPush=q?.fromPush==='1';void load()});async function load(){loading.value=true;try{notice.value=await fetchNoticeDetail(id);await readNoticeOne(notice.value!).catch(()=>{})}catch(e){error.value=e instanceof Error?e.message:'通知加载失败'}finally{loading.value=false}}const back=()=>{if(fromPush&&notice.value){uni.redirectTo({url:'/pages/notice/list?categoryId='+notice.value!.categoryId+'&name='+encodeURIComponent(notice.value!.categoryName)+'&fromPush=1'});return;}getCurrentPages().length>1?uni.navigateBack():uni.reLaunch({url:'/pages/index/index?tab=message'});};const post=()=>notice.value?.postId&&uni.navigateTo({url:'/pages/post/index?id='+notice.value.postId});let currentUser=getUserInfo()?.userId||'';
watch(authRevision,()=>{const user=getUserInfo()?.userId||'';if(user!==currentUser){currentUser=user;notice.value=undefined;error.value='';}});
onShow(()=>{if(!notice.value&&!loading.value)void load()});
onBackPress(()=>{if(fromPush&&notice.value){back();return true;}return false;});</script>
