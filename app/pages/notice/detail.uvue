.detail-page{position:fixed;inset:0;display:flex;flex-direction:column;background:#fff}.page-header{flex-shrink:0;display:flex;align-items:flex-end;border-bottom:1rpx solid #eee;flex-direction:row}.page-header button,.page-header view{width:96rpx;height:88rpx;display:flex;align-items:center;justify-content:center;background:transparent;border:0;flex-direction:row}.page-header button::after{border:0}.page-header>text{height:88rpx;line-height:88rpx;flex:1;text-align:center;font-size:30rpx;font-weight:600}.detail-scroll{flex:1;height:0}.article{display:block;padding:42rpx 36rpx 80rpx}.title{display:block;font-size:40rpx;line-height:1.35;font-weight:700}.time{display:block;margin-top:18rpx;color:#999;font-size:22rpx}.blocks{margin-top:38rpx}.paragraph{display:block;margin-bottom:28rpx;white-space:pre-wrap;font-size:29rpx;line-height:1.8;color:#333}.content-image{display:block;width:100%;margin-bottom:28rpx;border-radius:14rpx}.post-link{width:100%;height:86rpx;margin-top:30rpx;border:0;border-radius:43rpx;background:var(--brand);color:#fff;font-size:28rpx}.post-link::after{border:0}
