<template><view class="notice-page" :class="[uxNative?'ux1':'',uxNative?'ux2':'']"><view class="page-header" :style="{paddingTop:statusBarHeight+'px'}" :class="[uxNative?'ux1':'',uxNative?'ux3':'']"><ActionButton :aria-label="&quot;返回&quot;" @tap="back" :class="[uxNative?'ux4':'',uxNative?'ux5':'']"><AppIcon name="back" :size="40" /></ActionButton><text :class="[uxNative?'ux6':'',uxNative?'ux7':'',uxNative?'ux8':'']">{{name}}</text><view  :class="[uxNative?'ux1':'',uxNative?'ux9':'']"/></view><scroll-view class="notice-scroll" direction="vertical" :show-scrollbar="false" :lower-threshold="100" @scrolltolower="load" :class="[uxNative?'ux10':'',uxNative?'ux11':'']"><ActionButton :aria-label="String(item.title) + ' ' + String(item.publishTime)" v-for="(item, __uxIndex0) in rows" :key="item.id" class="notice-row" @tap="detail(item.id)" :class="[uxNative?'ux4':'',uxNative?'ux12':'']"><view :class="[uxNative?'ux1':'',uxNative?'ux13':'']"><text class="title" :class="[uxNative?'ux6':'',uxNative?'ux14':'',uxNative?'ux7':'',uxNative?'ux15':'']">{{item.title}}</text><text class="time" :class="[uxNative?'ux6':'',uxNative?'ux14':'',uxNative?'ux7':'',uxNative?'ux16':'']">{{item.publishTime}}</text></view><AppIcon name="chevron" tone="muted" :size="30" /></ActionButton><EmptyState v-if="!loading && !error && !rows.length" /><view v-else class="load-tip" :class="[uxNative?'ux1':'',uxNative?'ux17':'']"><text :class="[uxNative?'ux6':'',uxNative?'ux18':'',uxNative?'ux7':'']">{{loading?'加载中…':error||(hasMore?'上拉加载更多':'已经到底了')}}</text></view></scroll-view><EyeCareOverlay /></view></template>
<script setup lang="uts">
import EmptyState from '@/components/EmptyState.uvue'
import ActionButton from '@/components/ActionButton.uvue'

import { notifyWindowResize } from '@/utils/window-events'
onResize(notifyWindowResize)

import { uxNative, uxClass, uxMedia } from '@/utils/native-styles';
import {authRevision,getUserInfo} from '@/utils/auth';import {readNoticeCategory} from '@/utils/notice-state';import {ref,watch} from 'vue';import AppIcon from '@/components/AppIcon.uvue';import {useWindowInsets} from '@/composables/useWindowInsets';import {fetchNoticeList} from '@/utils/notice-api';import type {NoticeListItem} from '@/types/home';const {statusBarHeight}=useWindowInsets();const name=ref('通知'),rows=ref<NoticeListItem[]>([]),loading=ref(false),error=ref(''),hasMore=ref(true);let categoryId=0,page=1,fromPush=false;async function load(){if(loading.value||!hasMore.value)return;loading.value=true;error.value='';try{const result=await fetchNoticeList(categoryId,page);rows.value.push(...result.records);if(page===1)await readNoticeCategory(categoryId,result.readPublicationIds||[]).catch(()=>{});hasMore.value=page<result.pages&&result.records.length>0;page++}catch(e){error.value=e instanceof Error?e.message:'通知加载失败'}finally{loading.value=false}}onLoad(q=>{categoryId=Number(q?.categoryId||0);fromPush=q?.fromPush==='1';name.value=decodeURIComponent(q?.name??'通知')!;void load()});const detail=(id:number)=>uni.navigateTo({url:'/pages/notice/detail?id='+id});const back=()=>fromPush?uni.reLaunch({url:'/pages/index/index?tab=message'}):getCurrentPages().length>1?uni.navigateBack():uni.reLaunch({url:'/pages/index/index?tab=message'});let currentUser=getUserInfo()?.userId||'';let reloadPending=false;
watch(authRevision,()=>{const user=getUserInfo()?.userId||'';if(user!==currentUser){currentUser=user;rows.value=[];page=1;hasMore.value=true;error.value='';reloadPending=true;}});
onShow(()=>{if(reloadPending){reloadPending=false;void load()}});
onBackPress(()=>{if(fromPush){back();return true;}return false;});</script>
