.notice-page{position:fixed;inset:0;display:flex;flex-direction:column;background:#fff}.page-header{flex-shrink:0;display:flex;align-items:flex-end;border-bottom:1rpx solid #eee;flex-direction:row}.page-header button,.page-header view{width:96rpx;height:88rpx;display:flex;align-items:center;justify-content:center;background:transparent;border:0;flex-direction:row}.page-header button::after{border:0}.page-header>text{height:88rpx;line-height:88rpx;flex:1;text-align:center;font-size:30rpx;font-weight:600}.notice-scroll{flex:1;height:0}.notice-row{width:100%;min-height:128rpx;padding:24rpx 32rpx;display:flex;align-items:center;text-align:left;background:#fff;border:0;border-bottom:1rpx solid #f1f1f1;flex-direction:row}.notice-row::after{border:0}.notice-row>view{flex:1;min-width:0;display:flex;flex-direction:column}.title{font-size:28rpx;color:#222;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.time{margin-top:14rpx;color:#a2a6a9;font-size:20rpx}
/* #endif */
</style>

