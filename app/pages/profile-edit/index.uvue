<template>
  <view class="profile-page" :style="{ paddingTop: statusBarHeight + 'px' }" :class="[uxNative?'ux0':'',uxNative?'ux1':'']">
    <view class="profile-nav" :class="[uxNative?'ux0':'',uxNative?'ux2':'']">
      <ActionButton class="back-button" aria-label="返回" @tap="back" :class="[uxNative?'ux3':'',uxNative?'ux4':'']"><AppIcon name="back" :size="42" /></ActionButton>
      <text :class="[uxNative?'ux5':'',uxNative?'ux6':'',uxNative?'ux7':'',uxNative?'ux8':'']">修改信息</text>
    </view>

    <scroll-view direction="vertical" class="profile-scroll" :class="[uxNative?'ux9':'',uxNative?'ux10':'']">
      <view class="profile-content" :class="[uxNative?'ux0':'',uxNative?'ux11':'']" :style="uxLayout(uxNodePrefix+'-n0',[{on:uxNative,declarations:{&quot;min-height&quot;:&quot;100%&quot;,&quot;padding-bottom&quot;:&quot;max(40rpx, env(safe-area-inset-bottom))&quot;}}],{})" :id="uxNodePrefix+'-n0'">
        <view class="avatar-section" :class="[uxNative?'ux0':'',uxNative?'ux12':'']">
          <ActionButton :aria-label="&quot;点击修改头像&quot;" class="avatar-button" @tap="go('/pages/profile-edit/avatar')" :class="[uxNative?'ux3':'',uxNative?'ux13':'']">
            <UserAvatar :src="user?.avatar" :user-id="user?.userId" :frame-id="user?.avatarFrame" :size="100" />
            <text :class="[uxNative?'ux5':'',uxNative?'ux6':'',uxNative?'ux15':'',uxNative?'ux8':'']" :style="uxLayout(uxNodePrefix+'-g1001',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;21rpx&quot;,&quot;__direction&quot;:&quot;column&quot;}},{on:true,declarations:{__index:String(0+1)}}],{})" :id="uxNodePrefix+'-g1001'">点击修改头像</text>
          </ActionButton>
          <ActionButton :aria-label="&quot;更换个性装扮&quot;" class="decoration-button" @tap="openDecoration" :class="[uxNative?'ux3':'',uxNative?'ux16':'']">
            <text :class="[uxNative?'ux5':'',uxNative?'ux6':'',uxNative?'ux17':'',uxNative?'ux8':'']" :style="uxLayout(uxNodePrefix+'-g1002',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;11rpx&quot;,&quot;__direction&quot;:&quot;row&quot;,&quot;__padding&quot;:&quot;42rpx&quot;}},{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-g1002'">更换个性装扮</text><AppIcon name="chevron-round" :size="32"  :style="uxLayout(uxNodePrefix+'-g1003',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;11rpx&quot;,&quot;__direction&quot;:&quot;row&quot;,&quot;__padding&quot;:&quot;42rpx&quot;}},{on:true,declarations:{__index:String(0+1)}}],{})" :id="uxNodePrefix+'-g1003'"/>
          </ActionButton>
        </view>

        <view class="profile-card" :class="[uxNative?'ux0':'',uxNative?'ux18':'']">
          <ActionButton :aria-label="&quot;昵称&quot; + ' ' + String(user?.nickname || '')" class="profile-row" hover-class="row-hover" @tap="go('/pages/profile-edit/nickname')" :class="[uxNative?'ux3':'',uxNative?'ux19':'']">
            <text class="row-title" :class="[uxNative?'ux5':'',uxNative?'ux6':'',uxNative?'ux20':'',uxNative?'ux8':'',uxNative?'ux21':'']">昵称</text>
            <view class="row-side" :class="[uxNative?'ux0':'',uxNative?'ux22':'']"><text class="row-value" :class="[uxNative?'ux5':'',uxNative?'ux6':'',uxNative?'ux20':'',uxNative?'ux8':'',uxNative?'ux23':'']" :style="uxLayout(uxNodePrefix+'-g1004',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;12rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-g1004'">{{ user?.nickname || '' }}</text><RowArrow  :style="uxLayout(uxNodePrefix+'-g1005',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;12rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0+1)}}],{})" :id="uxNodePrefix+'-g1005'"/></view>
          </ActionButton>
          <ActionButton :aria-label="&quot;性别&quot; + ' ' + String(genderLabel)" class="profile-row" hover-class="row-hover" :disabled="savingGender" @tap="openGenderSheet" :class="[uxNative?'ux3':'',uxNative?'ux19':'']">
            <text class="row-title" :class="[uxNative?'ux5':'',uxNative?'ux6':'',uxNative?'ux20':'',uxNative?'ux8':'',uxNative?'ux21':'']">性别</text>
            <view class="row-side" :class="[uxNative?'ux0':'',uxNative?'ux22':'']"><text class="row-value" :class="[uxNative?'ux5':'',uxNative?'ux6':'',uxNative?'ux20':'',uxNative?'ux8':'',uxNative?'ux23':'']" :style="uxLayout(uxNodePrefix+'-g1006',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;12rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-g1006'">{{ genderLabel }}</text><RowArrow  :style="uxLayout(uxNodePrefix+'-g1007',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;12rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0+1)}}],{})" :id="uxNodePrefix+'-g1007'"/></view>
          </ActionButton>
          <ActionButton :aria-label="&quot;个性签名&quot; + ' ' + String(signaturePreview)" class="profile-row signature-row" hover-class="row-hover" @tap="go('/pages/profile-edit/signature')" :class="[uxNative?'ux3':'',uxNative?'ux19':'',uxNative?'ux24':'']">
            <text class="row-title" :class="[uxNative?'ux5':'',uxNative?'ux6':'',uxNative?'ux20':'',uxNative?'ux8':'',uxNative?'ux21':'']">个性签名</text>
            <view class="row-side" :class="[uxNative?'ux0':'',uxNative?'ux22':'']"><text class="row-value signature-value" :class="[uxNative?'ux5':'',uxNative?'ux6':'',uxNative?'ux20':'',uxNative?'ux8':'',uxNative?'ux23':'',uxNative?'ux25':'']" :style="uxLayout(uxNodePrefix+'-g1008',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;12rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-g1008'" :max-lines="(uxNative) ? 2 : (undefined)">{{ signaturePreview }}</text><RowArrow  :style="uxLayout(uxNodePrefix+'-g1009',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;12rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0+1)}}],{})" :id="uxNodePrefix+'-g1009'"/></view>
          </ActionButton>
          <ActionButton :aria-label="&quot;标签&quot; + ' ' + String(tagsPreview)" class="profile-row" hover-class="row-hover" @tap="go('/pages/profile-edit/tags')" :class="[uxNative?'ux3':'',uxNative?'ux19':'']">
            <text class="row-title" :class="[uxNative?'ux5':'',uxNative?'ux6':'',uxNative?'ux20':'',uxNative?'ux8':'',uxNative?'ux21':'']">标签</text>
            <view class="row-side" :class="[uxNative?'ux0':'',uxNative?'ux22':'']"><text class="row-value" :class="[uxNative?'ux5':'',uxNative?'ux6':'',uxNative?'ux20':'',uxNative?'ux8':'',uxNative?'ux23':'']" :style="uxLayout(uxNodePrefix+'-g1010',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;12rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-g1010'">{{ tagsPreview }}</text><RowArrow  :style="uxLayout(uxNodePrefix+'-g1011',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;12rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0+1)}}],{})" :id="uxNodePrefix+'-g1011'"/></view>
          </ActionButton>
          <ActionButton :aria-label="&quot;卡片背景&quot;" class="profile-row" hover-class="row-hover" @tap="go('/pages/profile-edit/card-background')" :class="[uxNative?'ux3':'',uxNative?'ux19':'',uxNative?'ux26':'']">
            <text class="row-title" :class="[uxNative?'ux5':'',uxNative?'ux6':'',uxNative?'ux20':'',uxNative?'ux8':'',uxNative?'ux21':'']">卡片背景</text>
            <view class="row-side" :class="[uxNative?'ux0':'',uxNative?'ux22':'']"><image class="row-bg-preview" :src="uiAsset(cardBackgroundPreview)" mode="aspectFill"  :class="[uxNative?'ux27':'']" :style="uxLayout(uxNodePrefix+'-g1012',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;12rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-g1012'"/><RowArrow  :style="uxLayout(uxNodePrefix+'-g1013',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;12rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0+1)}}],{})" :id="uxNodePrefix+'-g1013'"/></view>
          </ActionButton>
        </view>
      </view>
    </scroll-view>

    <SettingsBottomSheet
      :visible="genderSheetVisible"
      title="性别"
      :options="genderOptions"
      :model-value="String(user?.gender ?? 2)"
      @select="selectGender"
      @close="closeGenderSheet"
    />
    <EyeCareOverlay />
  </view>
</template>

<script setup lang="uts">
import UserAvatar from '@/components/UserAvatar.uvue'

import { uiAsset } from '@/utils/ui-assets'
import ActionButton from '@/components/ActionButton.uvue'

import { notifyWindowResize } from '@/utils/window-events'
onResize(notifyWindowResize)

import { useNativeLayout } from '@/composables/useNativeLayout'
const { prefix: uxNodePrefix, style: uxLayout } = useNativeLayout();

import { uxNative, uxClass, uxMedia } from '@/utils/native-styles';

import { computed, ref } from 'vue'

import AppIcon from '@/components/AppIcon.uvue'
import EyeCareOverlay from '@/components/EyeCareOverlay.uvue'
import SettingsBottomSheet from '@/components/SettingsBottomSheet.uvue'
import { useWindowInsets } from '@/composables/useWindowInsets'
import { avatarUrl, getUserInfo, isLoggedIn, saveUserInfo } from '@/utils/auth'
import { updateGender } from '@/utils/auth-api'
import { cardBackgroundUrl } from '@/config/assets'

import RowArrow from '@/components/RowArrow.uvue'
const { statusBarHeight } = useWindowInsets()
const user = ref(getUserInfo())
const genderSheetVisible = ref(false)
const savingGender = ref(false)
let disposed = false

const genderOptions = [{ label: '男', value: '0' }, { label: '女', value: '1' }, { label: '保密', value: '2' }]
const genderLabel = computed(() => genderOptions.find(o => o.value === String(user.value?.gender ?? 2))?.label || '保密')
const signaturePreview = computed(() => user.value?.signature || '未设置')
const tagsPreview = computed(() => {
  const tags = user.value?.tags || []
  return tags.length ? tags.map(tag => tag.name).join('、') : '未设置'
})
const cardBackgroundPreview = computed(() => cardBackgroundUrl(user.value?.cardBackground))

function back() { getCurrentPages().length > 1 ? uni.navigateBack() : uni.reLaunch({ url: '/pages/index/index' }) }
function go(url: string) { uni.navigateTo({ url }) }
function openDecoration() { go('/pages/settings/avatar-frame') }
function openGenderSheet() { if (!savingGender.value) genderSheetVisible.value = true }
function closeGenderSheet() { genderSheetVisible.value = false }
async function selectGender(value: string) {
  closeGenderSheet()
  if (savingGender.value || String(user.value?.gender ?? 2) === value) return
  savingGender.value = true
  try {
    const updated = await updateGender(Number(value))
    if (disposed) return
    user.value = updated
    saveUserInfo(updated)
    uni.showToast({ title: '已保存', icon: 'success' })
  } catch { /* 请求层统一提示。 */ } finally { savingGender.value = false }
}
onShow(() => {
  if (!isLoggedIn()) { uni.reLaunch({ url: '/pages/login/index' }); return }
  user.value = getUserInfo()
})
onUnload(() => { disposed = true })
</script>

<style scoped>
/* #ifndef APP */
@import '@/styles/legacy-layout-base.css';
/* #endif */

/* #ifndef APP */

.profile-page { position: fixed; inset: 0; display: flex; flex-direction: column; overflow: hidden; background: #f7f7f7; color: #222628; padding-left: env(safe-area-inset-left); padding-right: env(safe-area-inset-right); }
.profile-nav { position: relative; display: flex; align-items: center; justify-content: center; height: 116rpx; flex-shrink: 0; background: #f7f7f7; color: #1f2325; font-size: 31rpx; font-weight: 600; flex-direction: row; }
.back-button { position: absolute; left: 27rpx; top: 50%; display: flex; align-items: center; justify-content: center; width: 58rpx; height: 68rpx; margin: 0; padding: 0; transform: translateY(-50%); border: 0; border-radius: 0; background: transparent; flex-direction: row; }
.back-button::after,.avatar-button::after,.decoration-button::after,.profile-row::after { border: 0; }
.profile-scroll { height: 0; flex: 1; }
.profile-content { min-height: 100%; padding-bottom: max(40rpx, env(safe-area-inset-bottom)); }
.avatar-section { position: relative; height: 390rpx; background: #fff; }
.avatar-button { display: flex; flex-direction: column; align-items: center; gap: 21rpx; margin: 0 auto; padding: 54rpx 0 0; border: 0; border-radius: 0; background: transparent; color: #202426; font-size: 25rpx; line-height: 1; }
.avatar-button image { display: block; width: 194rpx; height: 194rpx; border: 0; border-radius: 50%; background: #f1f4f5; }
.decoration-button { position: absolute; top: 42rpx; right: 0; display: flex; align-items: center; gap: 11rpx; height: 58rpx; margin: 0; padding: 0 21rpx 0 27rpx; border: 0; border-radius: 11rpx 0 0 11rpx; background: #f0f1f2; color: #222628; font-size: 23rpx; line-height: 34rpx; flex-direction: row; }
.profile-card { padding: 0 24rpx; background: #fff; }
.profile-row { display: flex; align-items: center; justify-content: flex-start; width: 100%; min-height: 96rpx; margin: 0; padding: 0; border: 0; border-bottom: 2rpx solid #f1f2f3; border-radius: 0; background: #fff; color: #222628; font-size: 28rpx; line-height: normal; text-align: left; flex-direction: row; }
.profile-row:last-child { border-bottom: 0; }
.signature-row { min-height: 126rpx; }
.row-hover { background: #fafafa; }
.row-title { width: 152rpx; flex-shrink: 0; color: #858d91; font-size: 25rpx; }
.row-side { display: flex; align-items: center; min-width: 0; flex: 1; gap: 12rpx; flex-direction: row; }
.row-value { min-width: 0; flex: 1; overflow: hidden; color: #202426; font-size: 27rpx; text-overflow: ellipsis; white-space: nowrap; }
.signature-value { display: -webkit-box; overflow: hidden; line-height: 1.45; white-space: normal; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.row-arrow { display: flex; align-items: center; flex-shrink: 0; flex-direction: row; }
.row-bg-preview { width: 96rpx; height: 60rpx; border-radius: 8rpx; flex-shrink: 0; background: #ececec; }

/* #endif */
</style>

