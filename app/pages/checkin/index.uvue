<template>
 <view class="checkin-page">
  <view class="checkin-nav" :style="{paddingTop:statusBarHeight+'px'}"><view class="checkin-nav-row"><ActionButton class="nav-button" aria-label="返回" @tap="back"><AppIcon name="back" :size="42" /></ActionButton><text class="nav-title">次元町每日签到</text><ActionButton class="nav-button" aria-label="分享（暂未开放）" @tap="unavailable"><AppIcon name="share" :size="40" /></ActionButton></view></view>
  <scroll-view direction="vertical" class="checkin-scroll">
   <view class="checkin-scene">
    <text class="sky-star star-one">✦</text><text class="sky-star star-two">✧</text><text class="sky-star star-three">✦</text>
    <view class="hero">
     <view class="hero-top"><view class="account-pill"><text class="account-text" :style="{ width: accountTextWidth }">{{accountLabel}}</text></view><view class="hero-tools"><ActionButton class="hero-tool" aria-label="签到记录" @tap="openHistory"><AppIcon name="book" tone="white" :size="35" /></ActionButton><ActionButton class="hero-tool" aria-label="签到规则" @tap="sheet='rules'"><text class="help-mark">?</text></ActionButton></view></view>
     <view class="hero-main"><image class="mascot" src="/static/images/checkin/mascot.webp" mode="aspectFit" /><image class="hero-title" src="/static/images/checkin/daily-checkin.png" mode="aspectFit" /></view>
    </view>
    <view v-if="loading&&!state" class="checkin-message"><text class="message-copy">正在展开本月星愿…</text></view>
    <view v-if="error" class="checkin-message"><text class="message-copy">{{error}}</text><ActionButton class="retry" aria-label="重新加载签到" @tap="load"><text>重新加载</text></ActionButton></view>
    <view v-if="state" class="parchment reward-panel">
     <view class="parchment-inner">
      <view class="month-summary"><view class="month-label"><text class="month-text">{{monthNumber}}月已累计签到 </text><text class="month-text count-accent">{{current.signedDays}}</text><text class="month-text"> 天</text></view><view class="makeup-summary"><text class="missed-text">{{'漏签 '+current.missedDays+' 天'}}</text><ActionButton class="makeup-button" aria-label="选择补签日期" :disabled="busy||current.missedDays===0" @tap="openMakeup"><text class="makeup-label">补签</text></ActionButton></view></view>
      <view class="reward-grid"><ActionButton v-for="(d,index) in shownDays" :key="d.day" class="reward-card" :class="{'reward-card-last-column':index%4===3,'reward-card-today':d.today,'reward-card-signed':d.signed}" :aria-label="'第'+d.day+'天'+(d.signed?'已签到':d.today?'今日奖励':'奖励')" :disabled="busy" @tap="showDay(d)">
       <view class="reward-art"><view class="reward-orbit" /><image class="reward-icon" :src="rewardIcon(d.reward)" mode="aspectFit" /><text v-if="d.signed" class="reward-check">✓</text><text class="reward-amount">{{rewardAmount(d.reward)}}</text><text v-if="rewardCount(d.reward)>1" class="combo-mark">＋</text></view>
       <view class="reward-label"><text class="day-label">第{{d.day}}天</text></view><view v-if="d.today&&!d.signed" class="today-dot" />
      </ActionButton></view>
      <ActionButton class="expand-rewards" :aria-label="expanded?'收起奖励':'查看全部奖励'" @tap="expanded=!expanded"><view class="down-disc"><text class="down-glyph">{{expanded?'▴':'▾'}}</text></view><text class="expand-label">{{expanded?'收起奖励':'查看全部奖励'}}</text></ActionButton>

     </view><view class="corner corner-left" /><view class="corner corner-right" />
    </view>
    <view class="parchment recommendation-panel"><view class="parchment-inner"><text class="recommendation-heading">推荐内容</text><view class="section-rule"><view class="rule-line" /><text class="rule-star">✦</text><view class="rule-line" /></view>
     <ActionButton v-for="post in recommendations" :key="post.id" class="recommendation-row" :aria-label="post.title" @tap="openPost(post.id)"><image v-if="post.coverUrl" class="recommendation-cover" :src="asset(post.coverUrl)" mode="aspectFill" /><view v-else class="recommendation-cover cover-empty"><text class="cover-star">✦</text></view><view class="recommendation-copy"><text class="recommendation-title">{{post.title}}</text><text class="recommendation-excerpt">{{post.excerpt}}</text></view></ActionButton>
     <EmptyState v-if="!recommendations.length && !recommendationError && !recommendationLoading" compact /><ActionButton v-if="recommendationError" class="expand-rewards" @tap="loadRecommendations"><text class="expand-label">推荐内容加载失败，点击重试</text></ActionButton>
     <ActionButton class="expand-rewards" aria-label="查看更多，前往全部频道" @tap="viewMore"><view class="down-disc"><text class="down-glyph">▾</text></view><text class="expand-label">查看更多</text></ActionButton>
    </view><view class="corner corner-left" /><view class="corner corner-right" /></view>
    <view class="scene-bottom" :style="{height:(bottomInset+24)+'px'}" />
   </view>
  </scroll-view>
  <view v-if="sheet" class="sheet-overlay" @tap="closeSheet"><view class="sheet" @tap.stop><view class="sheet-header"><text class="sheet-title">{{sheetTitle}}</text><ActionButton class="sheet-close" aria-label="关闭" @tap="closeSheet"><AppIcon name="close" :size="32" /></ActionButton></view>
   <scroll-view direction="vertical" class="sheet-scroll">
    <view v-if="sheet==='rules'" class="rules-copy"><text class="rule-paragraph">每天北京时间 00:00 开始新一天，按日期领取对应奖励。每月自动按实际天数展示，月底后重新开始。</text><text class="rule-paragraph">次元币、经验与头像框可组合赠送。连续实际签到每满 7 天，额外经验按社区等级规则发放。</text><text class="rule-paragraph">补签仅限本月过去未签到日期，每次消耗 {{current.makeupPrice||0}} 次元币。补签计入当月签到天数，不修复连续签到。</text><text class="rule-paragraph">限时头像框从领取时开始计时，重复领取续期；永久框不会降级。奖励配置调整不影响已经领取的奖励。</text></view>
    <view v-if="sheet==='makeup'&&state" class="makeup-picker"><text class="picker-tip">选择要补签的日期，每次 {{current.makeupPrice}} 次元币</text><view class="picker-grid"><ActionButton v-for="d in missedDays" :key="d.day" class="picker-day" :aria-label="'补签'+d.day+'日'" :disabled="busy" @tap="showDay(d)"><text class="picker-day-label">{{d.day}}日</text><text class="picker-cost">{{rewardAmount(d.reward)}}</text></ActionButton></view></view>
    <view v-if="sheet==='reward'&&selectedDay" class="reward-details"><image class="detail-icon" :src="rewardIcon(selectedReward)" mode="aspectFit" /><text class="detail-date">{{monthNumber}}月 第{{selected.day}}天</text><text class="detail-rewards">{{rewardDescription(selectedReward)}}</text><text v-if="selected.signed" class="detail-status">{{selected.makeup?'已补签领取':'已签到领取'}}</text><ActionButton v-else-if="selected.today" class="sign-button" :disabled="busy" @tap="sign"><text class="sign-label">领取今日奖励</text></ActionButton><ActionButton v-else-if="selected.canMakeup" class="sign-button" :disabled="busy" @tap="confirmMakeup"><text class="sign-label">消耗 {{current.makeupPrice}} 次元币补签</text></ActionButton><text v-else class="detail-status">当天签到即可领取</text></view>
    <view v-if="sheet==='history'" class="history-list"><EmptyState v-if="!historyRows.length && !historyLoading && !historyError" compact /><view v-for="row in historyRows" :key="row.signDate" class="history-row"><text class="history-date">{{row.signDate}}　{{row.makeup?'补签':'签到'}}</text><text class="history-reward">{{historyReward(row.rewardJson)}}</text></view><ActionButton v-if="historyPage<=historyPages||historyError" class="expand-rewards" :disabled="historyLoading" @tap="moreHistory"><text class="expand-label">{{historyLoading?'加载中…':historyError?'加载失败，点击重试':'加载更多'}}</text></ActionButton></view>
   </scroll-view><view :style="{height:Math.max(16,bottomInset)+'px'}" />
  </view></view>
 </view>
</template>
<script setup lang="uts">
import EmptyState from '@/components/EmptyState.uvue'
import {computed,ref,onBeforeUnmount} from 'vue'
import ActionButton from '@/components/ActionButton.uvue'
import AppIcon from '@/components/AppIcon.uvue'
import {useWindowInsets} from '@/composables/useWindowInsets'
import {getUserInfo,isLoggedIn,getSessionGeneration,saveUserInfo} from '@/utils/auth'
import {fetchMe} from '@/utils/auth-api'
import {fetchCheckinState,claimCheckin,makeupCheckin,fetchCheckinRecommendations,fetchCheckinHistory} from '@/utils/checkin-api'
import {fetchHomeConfig} from '@/utils/home-config-api'
import {API_BASE_URL} from '@/config/env'
import {openDestination} from '@/utils/navigation'
import {setStatusBar} from '@/utils/platform'
import type {CheckinState,CheckinConfig,CheckinDay,CheckinDayView,CheckinRecommendation} from '@/types/checkin'
const {statusBarHeight,bottomInset}=useWindowInsets()
const user=ref(getUserInfo()),state=ref<CheckinState|null>(null),loading=ref(false),busy=ref(false),error=ref(''),expanded=ref(false)
const emptyConfig:CheckinConfig={version:0,makeupPrice:10,coinIcon:{url:'',originalBytes:0,processedBytes:0},experienceIcon:{url:'',originalBytes:0,processedBytes:0},frames:[],days:[]}
const emptyState:CheckinState={today:'',month:'',daysInMonth:0,signedDays:0,missedDays:0,balance:0,makeupPrice:10,signedToday:false,days:[],config:emptyConfig}
const current=computed(()=>state.value||emptyState)
const accountLabel=computed(()=>'UID: '+(user.value?.publicUid||'—'))
const accountTextWidth=computed(()=>(accountLabel.value.length*16+4)+'rpx')
const recommendations=ref<CheckinRecommendation[]>([]),recommendationError=ref(false),recommendationLoading=ref(true)
const sheet=ref(''),selectedDay=ref<CheckinDayView|null>(null)
const emptyReward:CheckinDay={day:0,coins:0,experience:0,frameId:'',frameDays:0,primary:'coins'}
const emptyDay:CheckinDayView={day:0,reward:emptyReward,signed:false,makeup:false,today:false,canMakeup:false}
const selected=computed(()=>selectedDay.value||emptyDay)
const selectedReward=computed(()=>selected.value.reward)
const sheetTitle=computed(()=>sheet.value==='rules'?'签到规则':sheet.value==='history'?'签到记录':sheet.value==='makeup'?'补签日历':'签到奖励')
const monthNumber=computed(()=>Number(state.value?.month.split('-')[1]||0))
const missedDays=computed(()=>state.value?.days.filter(d=>d.canMakeup)||[])
const shownDays=computed(()=>{const s=state.value;if(!s)return [];if(expanded.value)return s.days;const today=Number(s.today.slice(-2));let start=Math.floor((today-1)/4)*4;if(start+8>s.daysInMonth)start=Math.max(0,Math.ceil(s.daysInMonth/4)*4-8);return s.days.slice(start,start+8)})
const historyRows=ref<{signDate:string;makeup:boolean;rewardJson:string;claimedAt:string}[]>([]),historyLoading=ref(false),historyError=ref(false)
let historyPage=1;const historyPages=ref(1)
let disposed=false,generation=0;let midnightTimer:ReturnType<typeof setTimeout>|null=null
onBeforeUnmount(()=>{disposed=true;generation++;if(midnightTimer!=null)clearTimeout(midnightTimer)})
function valid(session:number,revision:number):boolean{return !disposed&&session===getSessionGeneration()&&revision===generation}
function scheduleMidnight(){if(midnightTimer!=null)clearTimeout(midnightTimer);const now=Date.now(),offset=8*3600000;const remaining=86400000-(now+offset)%86400000;midnightTimer=setTimeout(()=>{void load()},remaining+100)}
async function load(){if(busy.value)return;if(!isLoggedIn()){uni.redirectTo({url:'/pages/login/index'});return;}const session=getSessionGeneration(),revision=++generation;loading.value=true;error.value='';try{const values=await Promise.all([fetchCheckinState(),fetchMe()]);if(!valid(session,revision))return;state.value=values[0];user.value=values[1];saveUserInfo(values[1]);scheduleMidnight()}catch(e){if(valid(session,revision))error.value=e instanceof Error?e.message:'签到加载失败，请重试'}finally{if(valid(session,revision))loading.value=false}}
async function loadRecommendations(){recommendationLoading.value=true;recommendationError.value=false;try{const rows=await fetchCheckinRecommendations();if(!disposed)recommendations.value=rows}catch{if(!disposed)recommendationError.value=true}finally{if(!disposed)recommendationLoading.value=false}}
function refreshPage(){uni.loadFontFace({family:'CheckinWenkai',source:'url("/static/fonts/LXGWWenKaiLite-Regular.ttf")',fail:()=>{}});void load();void loadRecommendations()}
// Android Vapor 5.26 traverses the live rpx text registry during initial
// layout. Wait until that layout finishes before replacing loading text or
// inserting rewards/recommendations from a fast response.
// #ifdef APP-ANDROID
let pageReady=false
onReady(()=>{pageReady=true;if(!disposed)refreshPage()})
// #endif
onShow(()=>{
 setStatusBar('dark')
 // #ifdef APP-ANDROID
 if(!pageReady)return
 // #endif
 refreshPage()
})
function asset(url:string):string{return url.startsWith('/uploads/')?API_BASE_URL+url:url}
function rewardIcon(r:CheckinDay):string{const c=state.value?.config;if(!c)return '';const url=r.primary==='frame'?c.frames.find(f=>f.id===r.frameId)?.image.url:r.primary==='experience'?c.experienceIcon.url:c.coinIcon.url;return asset(url||'')}
function rewardAmount(r:CheckinDay):string{return r.primary==='frame'?(r.frameDays===0?'永久':r.frameDays+'天'):'×'+(r.primary==='experience'?r.experience:r.coins)}
function rewardCount(r:CheckinDay):number{return (r.coins>0?1:0)+(r.experience>0?1:0)+(r.frameId?1:0)}
function rewardDescription(r:CheckinDay):string{const parts:string[]=[];if(r.coins>0)parts.push(r.coins+' 次元币');if(r.experience>0)parts.push(r.experience+' 经验');if(r.frameId){const f=state.value?.config.frames.find(f=>f.id===r.frameId);parts.push((f?.name||'头像框')+'（'+(r.frameDays===0?'永久':r.frameDays+'天')+'）')}return parts.join(' ＋ ')}
function historyReward(value:string):string{try{return rewardDescription(JSON.parse(value) as CheckinDay)}catch{return '历史签到'}}
function showDay(d:CheckinDayView){selectedDay.value=d;sheet.value='reward'}
function closeSheet(){if(!busy.value)sheet.value=''}
function openMakeup(){sheet.value='makeup'}
function unavailable(){uni.showToast({title:'功能暂未开放',icon:'none'})}
function back(){getCurrentPages().length>1?uni.navigateBack():uni.reLaunch({url:'/pages/index/index?tab=home'})}
function openPost(id:string){openDestination({kind:'post',title:'帖子详情',postId:id})}
async function viewMore(){try{const c=await fetchHomeConfig();if(disposed)return;const channel=c.channels.find(c=>c.showAllPosts);if(!channel){uni.showToast({title:'暂无全部帖子频道',icon:'none'});return;}uni.reLaunch({url:'/pages/index/index?tab=home&channelId='+encodeURIComponent(String(channel.id))})}catch{}}
async function sign(){await perform('')}
function confirmMakeup(){const s=state.value,d=selectedDay.value;if(!s||!d||!d.canMakeup||busy.value)return;const date=s.month+'-'+String(d.day).padStart(2,'0'),session=getSessionGeneration(),revision=generation;uni.showModal({title:'确认补签 '+date,content:'消耗 '+s.makeupPrice+' 次元币，获得 '+rewardDescription(d.reward)+'。当前余额 '+s.balance+' 次元币。',success:r=>{if(r.confirm&&valid(session,revision))void perform(date)}})}
async function perform(date:string){if(busy.value||!state.value)return;const session=getSessionGeneration(),revision=generation;busy.value=true;try{const r=date?await makeupCheckin(date,state.value.config.version):await claimCheckin();if(!valid(session,revision))return;state.value=r.state;sheet.value='';if(user.value){const updated=user.value;updated.level=r.progress.level;updated.coinBalance=r.state.balance;saveUserInfo(updated)}try{const profile=await fetchMe();if(valid(session,revision)){user.value=profile;saveUserInfo(profile)}}catch{}if(!valid(session,revision))return;uni.showToast({title:r.alreadySigned?'该日已领取':(date?'补签成功':'签到成功')+'，奖励已到账',icon:'none'});historyPage=1;historyPages.value=1;historyRows.value=[];scheduleMidnight()}catch{}finally{busy.value=false}}
function openHistory(){historyRows.value=[];historyPage=1;historyPages.value=1;historyError.value=false;sheet.value='history';void moreHistory()}
async function moreHistory(){if(historyLoading.value||historyPage>historyPages.value)return;const session=getSessionGeneration(),revision=generation;historyLoading.value=true;historyError.value=false;try{const r=await fetchCheckinHistory(historyPage);if(!valid(session,revision))return;historyRows.value.push(...r.records);historyPages.value=r.pages;historyPage++}catch{historyError.value=true}finally{historyLoading.value=false}}
</script>
<style scoped>
.checkin-page{position:fixed;left:0;right:0;top:0;bottom:0;display:flex;flex-direction:column;background-color:#7ab6c9}
.checkin-nav{background-color:#fff;flex-shrink:0}.checkin-nav-row{height:112rpx;padding:0 26rpx;display:flex;flex-direction:row;align-items:center}.nav-button{width:64rpx;height:64rpx;padding:0;margin:0;border-width:0;background-color:transparent;display:flex;align-items:center;justify-content:center}.nav-title{flex:1;text-align:center;font-size:32rpx;font-weight:700;letter-spacing:4rpx;color:#303332;font-family:CheckinWenkai}
.checkin-scroll{flex:1;height:0;min-height:0}.checkin-scene{position:relative;background-color:#6296b9;background-image:linear-gradient(to bottom,#4e76a9 0%,#6498b8 55%,#7bb7c8 100%);padding:0 30rpx;display:flex;flex-direction:column}.hero{position:relative;height:246rpx;flex-shrink:0}.hero-top{display:flex;flex-direction:row;align-items:center;justify-content:space-between;padding-top:24rpx}.account-pill{display:flex;flex-direction:row;align-items:center;border:2rpx solid #8eabd0;border-radius:40rpx;background-color:#6088bb;height:48rpx;padding:0 14rpx;margin:0}.account-text{font-size:22rpx;color:#f6f2df;font-family:CheckinWenkai}.hero-tools{display:flex;flex-direction:row}.hero-tool{width:48rpx;height:48rpx;border-radius:50%;border:2rpx solid #92b1d1;background-color:#739bc6;margin:0 0 0 14rpx;padding:0;display:flex;align-items:center;justify-content:center}.help-mark{color:#fff7da;font-size:36rpx;font-family:CheckinWenkai}.hero-main{display:flex;flex-direction:row;align-items:center;margin-top:12rpx;height:156rpx}.mascot{width:178rpx;height:178rpx;margin-left:30rpx;flex-shrink:0}.hero-title{width:380rpx;height:127rpx;margin-left:12rpx;flex-shrink:0}.sky-star{position:absolute;color:#b6cdd4;font-size:64rpx;opacity:0.23}.star-one{top:50rpx;left:410rpx}.star-two{top:144rpx;right:35rpx;font-size:40rpx}.star-three{top:22rpx;left:60rpx;font-size:28rpx}
.parchment{position:relative;border:6rpx solid #8bb2bb;background-color:#c5cfbb;border-radius:8rpx;margin-bottom:28rpx;padding:4rpx;box-shadow:0 5rpx 0 #5c89a7}.parchment-inner{overflow:visible;border:3rpx solid #d6d8ba;background-color:#fffdf0;padding:26rpx 22rpx 18rpx}.month-summary{display:flex;flex-direction:row;justify-content:space-between;align-items:center;flex-wrap:wrap;margin-bottom:42rpx;margin-top:4rpx}.month-label{display:flex;flex-direction:row;align-items:center}.month-text{font-size:29rpx;color:#938a70;font-family:CheckinWenkai;letter-spacing:1rpx}.count-accent{color:#c88d53}.makeup-summary{display:flex;flex-direction:row;align-items:center;margin-left:6rpx}.missed-text{font-size:22rpx;color:#a39778;font-family:CheckinWenkai}.makeup-button{border:2rpx solid #e2c9a2;background-color:#cb9059;border-radius:40rpx;padding:3rpx 18rpx;margin:0 0 0 12rpx;height:40rpx;display:flex;align-items:center;justify-content:center}.makeup-label{font-family:CheckinWenkai;color:#fff9e4;font-size:24rpx}.reward-grid{overflow:visible;display:flex;flex-direction:row;flex-wrap:wrap;justify-content:flex-start}.reward-card{position:relative;width:22%;margin:0 4% 24rpx 0;padding:0;border:2rpx solid #e5e3ca;border-radius:14rpx;background-color:#b6ad96;display:flex;flex-direction:column;overflow:visible}.reward-card-last-column{margin-right:0}.reward-art{position:relative;width:100%;height:150rpx;display:flex;align-items:center;justify-content:center;border-radius:12rpx 12rpx 0 0;overflow:hidden;background-image:linear-gradient(to bottom right,transparent 66%,#ffffff12 66%,#ffffff12 75%,transparent 75%)}.reward-orbit{position:absolute;width:110rpx;height:110rpx;top:14rpx;border-radius:50%;background-color:#fffdee;border:2rpx solid #e4dfc8}.reward-icon{position:absolute;top:21rpx;width:96rpx;height:96rpx}.reward-amount{position:absolute;bottom:6rpx;color:#fffbea;font-size:22rpx;font-family:CheckinWenkai}.reward-label{width:100%;height:48rpx;background-color:#fffef2;display:flex;justify-content:center;align-items:center;border-radius:0 0 12rpx 12rpx}.day-label{font-size:28rpx;color:#afa184;font-family:CheckinWenkai}.reward-card-today{background-color:#d48560;box-shadow:0 8rpx 28rpx #cfb29a;border-color:#e6d4b7}.reward-card-signed{opacity:0.64}.reward-check{position:absolute;top:3rpx;color:#6e9e28;font-size:110rpx;font-weight:800;line-height:125rpx;transform:rotate(7deg);text-shadow:2rpx 2rpx 0 #fffdf0}.today-dot{position:absolute;right:-13rpx;top:-13rpx;width:30rpx;height:30rpx;border-radius:50%;border:4rpx solid #fff9e4;background-color:#eb6244;box-shadow:0 0 8rpx #ef9179}.combo-mark{position:absolute;right:6rpx;bottom:7rpx;font-size:20rpx;color:#fffdee}.expand-rewards{display:flex;flex-direction:row;justify-content:center;align-items:center;padding:10rpx 0;margin:0;border-width:0;background-color:transparent;min-height:56rpx}.down-disc{width:26rpx;height:26rpx;border-radius:50%;background-color:#b8ad90;display:flex;align-items:center;justify-content:center;margin-right:10rpx}.down-glyph{color:#fffdf0;font-size:23rpx;line-height:25rpx}.expand-label{font-size:25rpx;color:#a59a7d;font-family:CheckinWenkai;letter-spacing:3rpx}.sign-button{display:flex;justify-content:center;align-items:center;background-color:#d18f57;border:2rpx solid #e5be8c;border-radius:38rpx;min-height:64rpx;margin:14rpx 36rpx 8rpx;padding:10rpx 20rpx}.sign-label{font-family:CheckinWenkai;font-size:28rpx;color:#fffbea}.sign-button-done{background-color:#b6b49c;border-color:#cfcdb7}.balance{text-align:center;font-size:20rpx;color:#a79e86;margin-top:8rpx;font-family:CheckinWenkai}.corner{position:absolute;bottom:8rpx;width:15rpx;height:15rpx;background-color:#e6e4cd}.corner-left{left:9rpx}.corner-right{right:9rpx}.recommendation-heading{font-size:34rpx;color:#8c8266;text-align:center;font-family:CheckinWenkai;letter-spacing:5rpx;margin-top:6rpx}.section-rule{display:flex;flex-direction:row;align-items:center;margin:20rpx 0 4rpx}.rule-line{flex:1;height:2rpx;background-color:#eeeadd}.rule-star{font-size:16rpx;color:#ded9c6;margin:0 8rpx}.recommendation-row{display:flex;flex-direction:row;width:100%;padding:26rpx 0;margin:0;border-width:0;border-bottom:2rpx solid #eeecdc;background-color:transparent;text-align:left;align-items:flex-start}.recommendation-cover{width:42%;height:158rpx;flex-shrink:0;border:2rpx solid #d6d6c2;border-radius:7rpx}.recommendation-copy{flex:1;min-width:0;padding-left:20rpx;display:flex;flex-direction:column}.recommendation-title{font-family:CheckinWenkai;font-size:26rpx;line-height:38rpx;color:#92866c;max-height:80rpx;overflow:hidden;text-overflow:ellipsis}.recommendation-excerpt{font-family:CheckinWenkai;font-size:23rpx;line-height:34rpx;color:#9b8f74;max-height:70rpx;margin-top:18rpx;overflow:hidden;text-overflow:ellipsis}.cover-empty{background-color:#d2dfdf;display:flex;justify-content:center;align-items:center}.cover-star{font-size:56rpx;color:#a0bac3}.recommendation-empty{font-family:CheckinWenkai;color:#a89d80;font-size:24rpx;padding:32rpx 0;text-align:center}.scene-bottom{width:100%}.checkin-message{padding:32rpx;background-color:#fffdf0;margin-bottom:24rpx;border-radius:8rpx;display:flex;align-items:center;flex-direction:column}.message-copy{color:#95896e;font-family:CheckinWenkai}.retry{margin-top:20rpx;background-color:#d18f57;border-width:0;border-radius:32rpx;padding:10rpx 24rpx}
.sheet-overlay{position:fixed;left:0;right:0;top:0;bottom:0;background-color:#00000066;display:flex;justify-content:flex-end;flex-direction:column;z-index:20}.sheet{max-height:1000rpx;background-color:#fffdf0;border-radius:28rpx 28rpx 0 0;padding:24rpx 30rpx 0;display:flex;flex-direction:column}.sheet-header{display:flex;flex-direction:row;align-items:center;justify-content:space-between;padding-bottom:20rpx}.sheet-title{font-family:CheckinWenkai;font-size:32rpx;color:#82775e}.sheet-close{margin:0;padding:0;width:48rpx;height:48rpx;background-color:transparent;border-width:0}.sheet-scroll{max-height:800rpx;flex-shrink:1}.rules-copy{display:flex;flex-direction:column}.rule-paragraph{font-family:CheckinWenkai;font-size:27rpx;line-height:44rpx;color:#8b8067;margin-bottom:22rpx}.picker-tip{font-family:CheckinWenkai;font-size:25rpx;color:#a39576;margin-bottom:24rpx}.picker-grid{display:flex;flex-direction:row;flex-wrap:wrap}.picker-day{width:20%;margin:8rpx 2%;padding:12rpx;border:2rpx solid #dedac3;border-radius:12rpx;display:flex;flex-direction:column;align-items:center;background-color:#f3efdc}.picker-day-label{font-family:CheckinWenkai;font-size:28rpx;color:#96876a}.picker-cost{font-family:CheckinWenkai;font-size:20rpx;color:#b89a72}.reward-details{display:flex;flex-direction:column;align-items:center;padding:10rpx 0 30rpx}.detail-icon{width:150rpx;height:150rpx}.detail-date{font-family:CheckinWenkai;font-size:30rpx;color:#978769;margin-top:18rpx}.detail-rewards{font-family:CheckinWenkai;font-size:27rpx;color:#a68c60;text-align:center;margin:20rpx 0}.detail-status{font-family:CheckinWenkai;font-size:25rpx;color:#a49b83;margin-top:16rpx}.history-row{padding:20rpx 0;border-bottom:1rpx solid #e8e2ce;display:flex;flex-direction:column}.history-date{font-family:CheckinWenkai;font-size:27rpx;color:#8d8064}.history-reward{font-family:CheckinWenkai;font-size:24rpx;color:#b19974;margin-top:8rpx}
/* #ifndef APP */
@font-face{font-family:CheckinWenkai;src:url('/static/fonts/LXGWWenKaiLite-Regular.ttf') format('truetype');font-display:swap}.checkin-scene{background:linear-gradient(180deg,#4e76a9 0%,#6498b8 55%,#7bb7c8 100%)}.reward-art{background-image:linear-gradient(135deg,transparent 66%,#ffffff12 66%,#ffffff12 75%,transparent 75%)}.recommendation-title,.recommendation-excerpt{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}.sheet-scroll{overflow:auto}.reward-check{-webkit-text-stroke:3rpx #fffdf0}.checkin-page button:after{border:none}
/* #endif */
