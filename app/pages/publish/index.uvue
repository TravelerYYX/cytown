<style scoped>
.publish-interaction-blocker { position:fixed; left:0; top:0; right:0; bottom:0; z-index:19; background-color:rgba(0,0,0,0); }
.publish-button-slot { flex:1; min-width:0; height:92rpx; display:flex; flex-direction:row; justify-content:center; align-items:center; }
.publish-button { flex-grow:0; flex-shrink:0; width:100%; position:relative; overflow:hidden; transition:width 300ms ease-in-out, border-radius 300ms ease-in-out; }
.publish-morph { width:92rpx; border-radius:46rpx; }
.publish-label { transition:opacity 150ms ease-in-out; }
.publish-label-hidden { opacity:0; }
.publish-spinner { transition:opacity 150ms ease-in-out; position:absolute; width:36rpx; height:36rpx; border-width:4rpx; border-style:solid; border-color:rgba(255,255,255,.35); border-top-color:#fff; border-radius:50%; }
.publish-spinner-fading { opacity:0; }
.publish-check { position:absolute; width:42rpx; height:32rpx; }
.publish-check-short, .publish-check-long { position:absolute; height:4rpx; border-radius:4rpx; background-color:#fff; transform-origin:left center; }
.publish-check-short { width:15rpx; left:2rpx; top:16rpx; transform:rotate(45deg); }
.publish-check-long { width:30rpx; left:12rpx; top:26rpx; transform:rotate(-45deg); }
/* #ifndef APP */
.publish-page .publish-button { flex:none; width:100%; }
.publish-page .publish-button.publish-morph { width:92rpx; border-radius:46rpx; }
.publish-spinner { animation:publish-spin 800ms linear infinite; }
.publish-check-short { animation:publish-check-short 180ms ease-in-out both; }
.publish-check-long { animation:publish-check-long 220ms ease-in-out 180ms both; }
@keyframes publish-spin { from { transform:rotate(0deg); } to { transform:rotate(360deg); } }
@keyframes publish-check-short { from { transform:rotate(45deg) scaleX(0); } to { transform:rotate(45deg) scaleX(1); } }
@keyframes publish-check-long { from { transform:rotate(-45deg) scaleX(0); } to { transform:rotate(-45deg) scaleX(1); } }
/* #endif */
</style>

