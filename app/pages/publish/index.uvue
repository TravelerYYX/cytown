:rgba(0,0,0,.35)}.cover-action text{position:relative;z-index:2}.copy{padding:0 34rpx}.title-row{height:90rpx;display:flex;align-items:center;border-bottom:1rpx solid #eee;flex-direction:row}.title{min-width:0;flex:1;font-size:28rpx}.title-row>text{color:#bbb;font-size:19rpx}.content,.post-text{width:100%;height:220rpx;padding:24rpx 0;font-size:25rpx;line-height:1.7}.post-editor{min-height:300rpx}.inline-preview{display:flex;flex-wrap:wrap;gap:12rpx;align-items:center;padding:12rpx 0;flex-direction:row}.inline-preview image{width:52rpx;height:52rpx}.mention,.link{color:#0aaee5}.inline-link{display:inline-flex;align-items:center;gap:3rpx;flex-direction:row}.block{position:relative;margin:16rpx 0;padding:12rpx;border-radius:12rpx;background:#f7f8f9}.block image,.block video{width:100%;max-height:420rpx;border-radius:10rpx}.divider,.poll-preview{display:block;padding:24rpx;text-align:center;color:#73787b}.block-remove{position:absolute;right:12rpx;top:12rpx;padding:8rpx 14rpx;border-radius:20rpx;background:rgba(0,0,0,.55);color:#fff;font-size:18rpx}.options{margin-top:18rpx;border-top:1rpx solid #eee}.option{width:100%;min-height:84rpx;display:flex;align-items:center;justify-content:space-between;padding:0 34rpx;box-sizing:border-box;border-bottom:1rpx solid #f3f3f3;flex-direction:row}.option>view{display:flex;align-items:center;gap:14rpx;font-size:24rpx;flex-direction:row}.option-end{display:flex;align-items:center;flex-shrink:0;gap:9rpx;max-width:55%;flex-direction:row}.option-end text{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#a4a9ab;font-size:21rpx}.required{color:#ff5d78}.toolbar{height:88rpx;display:flex;align-items:center;justify-content:space-around;border-top:1rpx solid #eee;flex-direction:row}.toolbar button{width:64rpx}.footer{min-height:118rpx;display:flex;align-items:center;gap:24rpx;padding:10rpx 34rpx 20rpx;flex-direction:row}.draft-button{width:94rpx;display:flex;flex-direction:column;align-items:center;gap:5rpx;font-size:18rpx}.publish-button{height:82rpx;flex:1;display:flex;align-items:center;justify-content:center;padding:0;line-height:1;border-radius:23rpx;background:#b8e7f5;color:#fff;font-size:27rpx;flex-direction:row}.publish-button.ready{background:#10b9ef}.mode-dock{min-height:114rpx;display:flex;justify-content:center;flex-direction:row}.mode-dock>button{width:31%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;font-size:27rpx;font-weight:600}.mode-dock button>view{width:40rpx;height:7rpx;margin-top:12rpx;border-radius:5rpx}.mode-dock button.active>view{background:#10b9ef}.mask{position:fixed;inset:0;z-index:20;display:flex;align-items:flex-end;justify-content:center;background:rgba(0,0,0,.45);flex-direction:row}.sheet{width:100%;padding:28rpx 34rpx max(38rpx,env(safe-area-inset-bottom));border-radius:28rpx 28rpx 0 0;background:#fff}.sheet-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:20rpx;font-size:28rpx;font-weight:600;flex-direction:row}.sheet-title button{color:#10b9ef;font-size:23rpx}.switch{min-height:86rpx;display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid #eee;font-size:23rpx;flex-direction:row}.exit-card{width:650rpx;margin-bottom:60rpx;padding:34rpx;border-radius:24rpx;background:#fff;text-align:center}.exit-card>text{display:block;margin-bottom:20rpx;font-size:26rpx}.exit-card button{height:80rpx;border-top:1rpx solid #eee}.exit-card .save-red{color:#ed3d4f}.exit-card .cancel{color:#999}.tool-sheet{max-height:620rpx}.tool-list{white-space:nowrap}.tool-list button{display:inline-flex;width:118rpx;flex-direction:column;align-items:center;gap:8rpx}.tool-list image{width:70rpx;height:70rpx}.colors{display:flex;flex-wrap:wrap;gap:28rpx;flex-direction:row}.colors button{width:64rpx;height:64rpx;border-radius:50%}.colors button.chosen{outline:5rpx solid #10b9ef}.vertical{max-height:400rpx;overflow:auto}.vertical button{width:100%;height:76rpx;text-align:left;border-bottom:1rpx solid #eee}.vertical button text{float:right;color:#aaa}.form{display:flex;flex-direction:column;gap:18rpx}.form input,.date-picker{height:72rpx;padding:0 18rpx;border-radius:10rpx;background:#f4f5f6;line-height:72rpx}.form radio-group,.form-actions{display:flex;gap:28rpx;flex-direction:row}.form .primary{height:72rpx;border-radius:12rpx;background:#10b9ef;color:#fff}.form-actions button{flex:1}.uploading{position:fixed;z-index:40;left:50%;top:45%;transform:translate(-50%,-50%);padding:24rpx 38rpx;border-radius:16rpx;background:rgba(0,0,0,.75);color:#fff}
