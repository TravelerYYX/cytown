// #ifdef WEB
import { API_BASE_URL } from '@/config/env'
import { getToken } from './auth'
import { chatOwner } from './chat-local'
import type { ChatAsset, ChatMessage } from '@/types/chat'
import {postChatWorker} from './chat-browser-bridge.js'
export const CHAT_DB='ct-private-chat-v1'
let database:Promise<IDBDatabase>|null=null
export function chatDatabase():Promise<IDBDatabase>{if(database)return database;database=new Promise((resolve,reject)=>{const request=indexedDB.open(CHAT_DB,1);request.onupgradeneeded=()=>{for(const name of ['media','chunks'])if(!request.result.objectStoreNames.contains(name))request.result.createObjectStore(name,{keyPath:'key'})};request.onsuccess=()=>resolve(request.result);request.onerror=()=>{database=null;reject(request.error)}});return database}
export async function chatDB<T>(store:string,mode:'readonly'|'readwrite',action:(store:IDBObjectStore)=>IDBRequest):Promise<T>{const db=await chatDatabase();return new Promise((resolve,reject)=>{const tx=db.transaction(store,mode);const request=action(tx.objectStore(store));let result:T;request.onsuccess=()=>{result=request.result as T};tx.oncomplete=()=>resolve(result);tx.onerror=()=>reject(tx.error);tx.onabort=()=>reject(tx.error)})}
export const webChatKey=(asset:ChatAsset,owner=chatOwner())=>owner+':'+asset.id+':'+asset.version
const flights=new Map<string,Promise<Blob>>()
const ownerEpoch=new Map<string,number>(),assetEpoch=new Map<string,number>()
const stamp=(owner:string,key:string)=>String(ownerEpoch.get(owner)||0)+':'+String(assetEpoch.get(key)||0)
export async function webChatBlob(asset:ChatAsset):Promise<Blob>{const key=webChatKey(asset),owner=chatOwner(),epoch=stamp(chatOwner(),webChatKey(asset));let flight=flights.get(key);if(flight)return flight;flight=(async()=>{const record=await chatDB<{key:string;blob?:Blob}|undefined>('media','readonly',s=>s.get(key));if(epoch!==stamp(owner,key))throw new Error('缓存操作已取消');if(record?.blob?.size===asset.sizeBytes)return record.blob;const response=await fetch(API_BASE_URL+'/app/chat/assets/'+asset.id+'/content',{headers:{Authorization:'Bearer '+getToken()}});if(!response||!response.ok||response.headers.get('content-type')?.includes('json'))throw new Error('私聊媒体加载失败');const blob=await response.blob();if(blob.size!==asset.sizeBytes)throw new Error('私聊媒体文件不完整');if(owner!==chatOwner()||epoch!==stamp(owner,key))throw new Error('缓存操作已取消');await chatDB('media','readwrite',s=>s.put({key,owner,assetId:asset.id,blob,size:blob.size}));return blob})();flights.set(key,flight);try{return await flight}finally{if(flights.get(key)===flight)flights.delete(key)}}
let workerFlight:Promise<void>|null=null
export async function ensureChatWorker():Promise<void>{if(!('serviceWorker'in navigator)||!window.isSecureContext)throw new Error('视频缓存播放需要HTTPS或localhost环境');if(!workerFlight)workerFlight=(async()=>{await navigator.serviceWorker.register('/chat-cache-worker.js',{scope:'/'});await navigator.serviceWorker.ready;if(!navigator.serviceWorker.controller)await new Promise<void>((resolve,reject)=>{const timer=setTimeout(()=>reject(new Error('视频缓存服务未就绪，请刷新页面')),10000);navigator.serviceWorker.addEventListener('controllerchange',()=>{clearTimeout(timer);resolve()},{once:true})})})();try{await workerFlight}catch(e){workerFlight=null;throw e}}
export async function webChatVideo(message:ChatMessage):Promise<{url:string;complete:boolean}>{await ensureChatWorker();const asset=message.asset!;const owner=chatOwner(),key=webChatKey(asset);const channel=new MessageChannel();const ready=new Promise<void>((resolve,reject)=>{const timer=setTimeout(()=>reject(new Error('视频缓存服务响应超时')),10000);channel.port1.onmessage=e=>{clearTimeout(timer);channel.port1.close();e.data.error?reject(new Error(e.data.error)):resolve()}});postChatWorker(navigator.serviceWorker.controller!,{type:'chat-video',key,owner,asset,messageId:message.id,peer:message.senderId!==owner,api:API_BASE_URL,token:getToken()},[channel.port2]);await ready;return {url:'/__ct_chat_video__/'+encodeURIComponent(key),complete:false}}
async function stopWorker(payload:Record<string,unknown>){if(!navigator.serviceWorker.controller)return;const worker=navigator.serviceWorker.controller;await new Promise<void>((resolve,reject)=>{const channel=new MessageChannel(),timer=setTimeout(()=>reject(new Error('缓存服务未响应，请重试')),5000);channel.port1.onmessage=()=>{clearTimeout(timer);channel.port1.close();resolve()};postChatWorker(worker,payload,[channel.port2])})}
export async function clearWebChatMedia(){const owner=chatOwner();ownerEpoch.set(owner,(ownerEpoch.get(owner)||0)+1);for(const key of flights.keys())if(key.startsWith(owner+':'))flights.delete(key);await stopWorker({type:'chat-clear',owner});const range=IDBKeyRange.bound(owner+':',owner+':\uffff');for(const key of await chatDB<string[]>('chunks','readonly',q=>q.getAllKeys(range)))await chatDB('chunks','readwrite',q=>q.delete(key));for(const key of await chatDB<string[]>('media','readonly',q=>q.getAllKeys(range)))await chatDB('media','readwrite',q=>q.delete(key))}
export async function removeWebChatMedia(asset:ChatAsset){const key=webChatKey(asset);assetEpoch.set(key,(assetEpoch.get(key)||0)+1);flights.delete(key);await stopWorker({type:'chat-remove',key});await chatDB('media','readwrite',s=>s.delete(key));const keys=await chatDB<string[]>('chunks','readonly',q=>q.getAllKeys(IDBKeyRange.bound(key+':',key+':\uffff')));for(const chunk of keys)await chatDB('chunks','readwrite',q=>q.delete(chunk))}
// #endif
