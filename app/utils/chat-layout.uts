// Reference chat thumbnails fit inside a 462rpx square while keeping the source ratio.
export function chatMediaSize(width:number,height:number,viewportWidth:number,emoji=false):{width:number;height:number}{
 const edge=viewportWidth*(emoji?240:462)/750
 if(width<=0||height<=0)return {width:edge,height:edge}
 const scale=Math.min(1,edge/width,edge/height)
 return {width:Math.max(1,Math.round(width*scale)),height:Math.max(1,Math.round(height*scale))}
}
