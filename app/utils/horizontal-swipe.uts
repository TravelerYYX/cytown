// Lock the direction early so a vertical scroll cannot turn into a tab switch.
export class HorizontalSwipe {
  private startX = 0
  private startY = 0
  private dx = 0
  private dy = 0
  private tracking = false
  private axis = 0
  begin(x: number, y: number): void {
    this.cancel()
    this.startX = x; this.startY = y; this.tracking = true
  }
  move(x: number, y: number): boolean {
    if (!this.tracking || this.axis === -1) return false
    this.dx = x - this.startX; this.dy = y - this.startY
    const xDistance = Math.abs(this.dx), yDistance = Math.abs(this.dy)
    if (this.axis === 0 && Math.max(xDistance, yDistance) >= 10) {
      if (xDistance > yDistance * 1.4) this.axis = 1
      else if (yDistance > xDistance || Math.max(xDistance, yDistance) >= 18) this.axis = -1
    }
    return this.axis === 1
  }
  release(): number {
    const direction = this.tracking && this.axis === 1 && Math.abs(this.dx) >= 48 && Math.abs(this.dx) > Math.abs(this.dy) * 1.4 ? (this.dx < 0 ? 1 : -1) : 0
    this.cancel()
    return direction
  }
  cancel(): void { this.tracking = false; this.axis = 0; this.dx = 0; this.dy = 0 }
}
