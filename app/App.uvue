<script setup lang="uts">
	import { flushMediaCacheMetadata, syncMediaCacheConfig } from '@/utils/media-cache'
	import { refreshNativePreferences } from '@/utils/native-styles'
	import { refreshOwnLocation } from '@/utils/user-location'
	onShow(() => { void refreshOwnLocation() })
	import { isLoggedIn } from '@/utils/auth'
	import { fetchMe } from '@/utils/auth-api'
	import { launchNotices, showNotices, hideNotices } from '@/utils/notice-state'
	import { launchChat, showChat, hideChat } from '@/utils/chat-state'
	import { launchSocial, showSocial, hideSocial } from '@/utils/social-inbox'
	onLaunch(launchSocial)
	onShow(showSocial)
	onHide(hideSocial)
	onLaunch(launchChat)
	onShow(showChat)
	onHide(hideChat)
	onLaunch(launchNotices)
	onShow(showNotices)
	onHide(hideNotices)

	import { launchAppUpdate, showAppUpdate, hideAppUpdate } from '@/utils/app-update'

	onLaunch(() => { void syncMediaCacheConfig() })
	onLaunch(launchAppUpdate)
	onShow(showAppUpdate)
	onHide(hideAppUpdate)
	onShow(refreshNativePreferences)
	// A remembered session counts on the first authenticated request of each Shanghai day.
	onShow(() => { if (isLoggedIn()) void fetchMe().catch(() => { }) })

	onHide(() => { void flushMediaCacheMetadata().catch(() => { }) })
</script>

