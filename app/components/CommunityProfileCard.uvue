<template>
  <view class="community-profile-card">
    <NativeRoleBackdrop :source="cardBackgroundUrl(profile.cardBackground)" />
    <view class="community-card-top">
      <view class="community-card-avatar"><UserAvatar :src="profile.avatar" :user-id="profile.userId" :frame-id="profile.avatarFrame" :frame-expires-at="profile.avatarFrameExpiresAt ?? undefined" :size="58" :radius="12" /></view>
      <view class="community-card-name"><text class="community-card-nickname" :max-lines="1">{{ profile.nickname }}</text><text class="community-card-server">次元町{{ profile.level }}级</text></view>
    </view>
    <view id="community-card-stats" class="community-card-stats">
      <view v-for="stat in stats" :key="stat.label" class="community-card-stat"><text class="community-card-value" :class="{'community-card-small':String(stat.value).length>8}" :max-lines="1">{{ stat.value }}</text><text class="community-card-label">{{ stat.label }}</text></view>
    </view>
  </view>
</template>
<script setup lang="uts">
import { computed } from 'vue'
import UserAvatar from './UserAvatar.uvue'
import NativeRoleBackdrop from './NativeRoleBackdrop.uvue'
import { cardBackgroundUrl } from '@/config/assets'
import type { UserProfile } from '@/utils/user-profile'
const props = defineProps<{ profile: UserProfile }>()
const stats = computed(() => [
  {label:'活跃天数',value:String(props.profile.statistics.activeDays ?? '—')},
  {label:'当前称号',value:props.profile.title || '—'},
  {label:'次元币',value:String(props.profile.coinBalance ?? '—')},
  {label:'幻想剧诗',value:'-'}
])
</script>
