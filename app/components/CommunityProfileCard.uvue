.community-card-stats{position:relative;display:flex;flex-direction:row;align-items:center;height:77rpx;flex-shrink:0;margin-top:5rpx;margin-left:10rpx;padding:0 4rpx;border-radius:14rpx;background-color:rgba(0,61,143,0.38);}
.community-card-stat{display:flex;flex-direction:column;align-items:center;justify-content:center;flex:1;min-width:0;}
