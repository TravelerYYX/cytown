<script setup lang="uts">
import { useNativeSemantics } from '@/composables/useNativeSemantics'
const { prefix: a11yPrefix, attrs: a11yAttrs } = useNativeSemantics()
import { uxNative, uxClass, uxMedia } from '@/utils/native-styles';

import { computed } from 'vue'
const props = withDefaults(defineProps<{ width?: number; height?: number; circle?: boolean; dark?: boolean; radius?: number; label?: string }>(), { circle: false, dark: false, radius: 12, label: '媒体占位' })
const blockStyle = computed(() => ({
  width: props.width === undefined ? '100%' : props.width + 'rpx',
  height: props.height === undefined ? '100%' : props.height + 'rpx',
  borderRadius: props.circle ? '50%' : props.radius + 'rpx'
}))
