.follow-view { background: #ffffff; }
.follow-header { z-index: 2; position: absolute; top: 0; left: 0; right: 0; background: #ffffff;  }
.header-title { height: 128rpx; display: flex; align-items: center; justify-content: center; font-size: 36rpx; font-weight: 600; flex-direction: row; }

/* #endif */
</style>

