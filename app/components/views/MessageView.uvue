<template>
  <view class="screen message-view" :class="[uxNative?'ux2':'',uxNative?'ux3':'']">
    <swiper class="message-swiper" :current="topTab === 'chat' ? 0 : 1" :duration="300" easing-function="easeOutCubic" @change="onTopTabSwipe">
      <swiper-item v-for="pane in messageTabs" :key="pane">
        <view class="message-pane">
          <view class="message-pane-spacer" :style="{ paddingTop: statusBarHeight + 'px' }">
            <view class="message-pane-header-space" />
          </view>
          <SocialInboxEntries v-if="pane === 'notice'" />
          <PaneScroll :style="{ height: '0px', flexGrow: 1 }" :active="paneVisible && topTab === pane" :scroll-top="pane === 'chat' ? chatScrollTop : noticeScrollTop" :show-scrollbar="false" @scroll="pane === 'chat' ? onChatScroll($event) : onNoticeScroll($event)" :class="[uxNative?'ux4':'']">
            <view v-if="pane==='chat'" class="chat-separator"  :class="[uxNative?'ux2':'',uxNative?'ux15':'']"/>
            <view v-if="loading&&pane==='notice'" class="load-tip" :class="[uxNative?'ux2':'',uxNative?'ux16':'']"><text :class="[uxNative?'ux11':'',uxNative?'ux17':'',uxNative?'ux14':'']">通知加载中…</text></view>
            <EmptyState v-if="!conversationsByTab[pane].length && (pane === 'chat' || (!loading && !noticeSyncError))" />
            <view class="conversation-list" :class="[uxNative?'ux2':'']">
              <ActionButton :aria-label="conversation.name + ' ' + (conversation.isTop?'置顶 ':'') + conversation.time + ' ' + conversation.lastMsg + (conversation.unread?' '+String(conversation.unread):'')" v-for="(conversation, __uxIndex1) in conversationsByTab[pane]" :key="conversation.id" class="conversation" @tap="openConversation(conversation)" :class="[uxNative?'ct-native-button':'',uxNative?'ux8':'',uxNative?'ux18':'']">
                <view class="conversation-avatar" @tap.stop="openConversationProfile(conversation)" :class="[uxNative?'ux2':'',uxNative?'ux19':'']"><image v-if="conversation.iconUrl" class="avatar-image" :src="conversationIcon(conversation.iconUrl)" mode="aspectFit"  :class="[uxNative?'ux20':'']"/><view v-else class="bell-avatar" :class="[uxNative?'ux2':'',uxNative?'ux21':'',uxNative?'ux22':'']"><AppIcon name="bell" :size="46" /></view></view>
                <view class="conversation-body" :class="[uxNative?'ux2':'',uxNative?'ux23':'']"><view class="conversation-top" :class="[uxNative?'ux2':'',uxNative?'ux24':'']"><text class="conversation-name" :class="[uxNative?'ux11':'',uxNative?'ux25':'',uxNative?'ux14':'',uxNative?'ux26':'']" :style="uxLayout(uxNodePrefix+'-'+pane+'-g1004'+'-'+[__uxIndex1].join('-'),[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;12rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-'+pane+'-g1004'+'-'+[__uxIndex1].join('-')">{{ conversation.name }}</text><text v-if="conversation.isTop" class="pinned" :class="[uxNative?'ux11':'',uxNative?'ux25':'',uxNative?'ux14':'',uxNative?'ux27':'']" :style="uxLayout(uxNodePrefix+'-'+pane+'-g1005'+'-'+[__uxIndex1].join('-'),[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;12rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0+1)}}],{})" :id="uxNodePrefix+'-'+pane+'-g1005'+'-'+[__uxIndex1].join('-')">置顶</text><text class="conversation-time" :class="[uxNative?'ux11':'',uxNative?'ux25':'',uxNative?'ux14':'',uxNative?'ux28':'']" :style="uxLayout(uxNodePrefix+'-'+pane+'-g1006'+'-'+[__uxIndex1].join('-'),[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;12rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0+1+(conversation.isTop?1:0))}}],{})" :id="uxNodePrefix+'-'+pane+'-g1006'+'-'+[__uxIndex1].join('-')">{{ conversation.time }}</text></view><view class="conversation-bottom" :class="[uxNative?'ux2':'',uxNative?'ux29':'']"><text class="conversation-preview" :class="[uxNative?'ux11':'',uxNative?'ux25':'',uxNative?'ux14':'',uxNative?'ux30':'']" :style="uxLayout(uxNodePrefix+'-'+pane+'-g1007'+'-'+[__uxIndex1].join('-'),[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;12rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-'+pane+'-g1007'+'-'+[__uxIndex1].join('-')">{{ conversation.lastMsg }}</text><text v-if="conversation.unread" class="unread" :class="[uxNative?'ux11':'',uxNative?'ux25':'',uxNative?'ux14':'',uxNative?'ux31':'']" :style="uxLayout(uxNodePrefix+'-'+pane+'-g1008'+'-'+[__uxIndex1].join('-'),[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;12rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0+1)}}],{})" :id="uxNodePrefix+'-'+pane+'-g1008'+'-'+[__uxIndex1].join('-')">{{ conversation.unread > 99 ? '99+' : conversation.unread }}</text></view></view>
              </ActionButton>
            </view><view v-if="pane==='chat'?chatError:noticeSyncError" class="load-tip"><text>{{pane==='chat'?chatError:noticeSyncError}}</text></view><view class="conversation-end"  :class="[uxNative?'ux2':'',uxNative?'ux32':'']"/>
          </PaneScroll>
        </view>
      </swiper-item>
    </swiper>
    <view class="message-header" :style="{ paddingTop: statusBarHeight + 'px' }" :class="[uxNative?'ux2':'',uxNative?'ux33':'']"><view class="header-body" :class="[uxNative?'ux2':'',uxNative?'ux34':'']"><view class="message-tabs" :class="[uxNative?'ux2':'',uxNative?'ux35':'']"><ActionButton :aria-label="&quot;聊天&quot;" class="message-tab" :class="[uxNative?'ct-native-button':'',{active:topTab==='chat'},uxNative?'ux8':'',uxNative?'ux39':'',uxNative&amp;&amp;!!(topTab==='chat')?'ux41':'']" @tap="switchTopTab('chat')" :style="uxLayout(uxNodePrefix+'-g1009',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;72rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-g1009'"><text :class="[uxNative?'ux11':'',uxNative?'ux43':'',uxNative&amp;&amp;!!(topTab==='chat')?'ux51':'',uxNative?'ux14':'']">聊天</text><view class="underline"  :class="[uxNative?'ux2':'',uxNative?'ux40':'',uxNative&amp;&amp;!!(topTab==='chat')?'ux52':'']"/></ActionButton><ActionButton :aria-label="&quot;通知&quot;" class="message-tab" :class="[uxNative?'ct-native-button':'',{active:topTab==='notice'},uxNative?'ux8':'',uxNative?'ux39':'',uxNative&amp;&amp;!!(topTab==='notice')?'ux41':'']" @tap="switchTopTab('notice')" :style="uxLayout(uxNodePrefix+'-g1010',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;72rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0+1)}}],{})" :id="uxNodePrefix+'-g1010'"><text :class="[uxNative?'ux11':'',uxNative?'ux43':'',uxNative&amp;&amp;!!(topTab==='notice')?'ux51':'',uxNative?'ux14':'']">通知</text><text v-if="notificationUnread>0" class="social-notice-count">{{notificationUnread>99?'99+':notificationUnread}}</text><view class="underline"  :class="[uxNative?'ux2':'',uxNative?'ux40':'',uxNative&amp;&amp;!!(topTab==='notice')?'ux52':'']"/></ActionButton></view><ActionButton class="icon-button" aria-label="消息设置" @tap="open('settings', '消息设置')" :class="[uxNative?'ct-native-button':'',uxNative?'ux8':'',uxNative?'ux37':'',uxNative?'ux53':'']"><AppIcon name="settings" :size="40" /></ActionButton></view></view>
  </view>
</template>
<script setup lang="uts">
import { openUserProfile } from '@/utils/navigation'
import SocialInboxEntries from '@/components/SocialInboxEntries.uvue'
import { refreshSocial,socialSummary } from '@/utils/social-inbox'
import EmptyState from '@/components/EmptyState.uvue'
import { uiAsset } from '@/utils/ui-assets'
import ActionButton from '@/components/ActionButton.uvue'
import { useNativeLayout } from '@/composables/useNativeLayout'
const { prefix: uxNodePrefix, style: uxLayout } = useNativeLayout();

import { uxNative, uxClass, uxMedia } from '@/utils/native-styles';

import PaneScroll from '@/components/PaneScroll.uvue'
import { usePaneScroll } from '@/composables/usePaneScroll'
import { usePaneVisibility } from '@/composables/usePaneVisibility'
import { useFreshTask } from '@/composables/useFreshTask'
import { mediaUrl as resourceUrl } from '@/utils/media-cache'

import { noticeSummary, noticeSyncError, refreshNotices } from '@/utils/notice-state'
import {chatTime} from '@/utils/chat-local'
import {DEFAULT_AVATAR} from '@/utils/auth'
const conversationIcon=(url?:string)=>{const source=url||'';return uiAsset(source.startsWith('/static/')?source:resourceUrl(source))}
import { chatConversations as liveChats,refreshChats,chatError } from '@/utils/chat-state'
const chatConversationRows=computed(()=>liveChats.value.map(item=>({...item,iconUrl:item.iconUrl||DEFAULT_AVATAR,time:chatTime(item.lastTime)})))
import { computed,onMounted,ref } from 'vue';import AppIcon from '@/components/AppIcon.uvue';import { openDestination } from '@/utils/navigation';import { fetchNoticeCategories,fetchNoticeList } from '@/utils/notice-api';import { API_BASE_URL } from '@/config/env';import type { Conversation,MessageCategory,NavigationKind,ViewProps } from '@/types/home.uts'
const notificationUnread=computed(()=>noticeSummary.value.unreadCount+socialSummary.value.unreadCount)
type NoticeConversation={id:string;categoryId:number;name:string;iconUrl:string;isTop:false;lastMsg:string;time:string;unread:number}
const props=defineProps<ViewProps>();const paneVisible=usePaneVisibility(()=>props.active);const topTab=ref<'chat'|'notice'>('chat');const categories=computed(()=>noticeSummary.value.categories);const loading=ref(false)
const noticeConversations=computed<NoticeConversation[]>(()=>noticeSummary.value.categories.map(category=>({id:'notice-'+category.id,categoryId:category.id,name:category.name,iconUrl:category.iconUrl,isTop:false,lastMsg:category.latestTitle||'暂无通知',time:category.latestTime?.slice(5,16)||'',unread:category.unreadCount})))
type MessageTab = 'chat' | 'notice'
const messageTabs: MessageTab[] = ['chat', 'notice']
const { requestedTop: chatScrollTop, onScroll: onChatScroll, scrollToTop: resetChatScroll } = usePaneScroll(() => paneVisible.value && topTab.value === 'chat')
const { requestedTop: noticeScrollTop, onScroll: onNoticeScroll, scrollToTop: resetNoticeScroll } = usePaneScroll(() => paneVisible.value && topTab.value === 'notice')
const conversationsByTab = computed(() => ({
  chat: chatConversationRows.value as Array<NoticeConversation | Conversation>,
  notice: noticeConversations.value as Array<NoticeConversation | Conversation>
}))
function switchTopTab(tab: MessageTab) {
  topTab.value = tab
  if (tab === 'chat') void resetChatScroll()
  else void resetNoticeScroll()
}
function onTopTabSwipe(event: { detail: { current: number } }) {
  const tab: MessageTab = event.detail.current === 0 ? 'chat' : 'notice'
  if (tab !== topTab.value) switchTopTab(tab)
}
const open=(kind:NavigationKind,title:string)=>openDestination({kind,title})
function openConversationProfile(item:NoticeConversation|Conversation){const peer=liveChats.value.find(x=>x.id===item.id)?.peerId;if(peer)openUserProfile(peer);else openConversation(item)}
function openCategory(category:MessageCategory){uni.navigateTo({url:'/pages/notice/list?categoryId='+category.id+'&name='+encodeURIComponent(category.name)})}
function openConversation(item:NoticeConversation|Conversation){if('categoryId'in item)uni.navigateTo({url:'/pages/notice/list?categoryId='+item.categoryId+'&name='+encodeURIComponent(item.name)});else uni.navigateTo({url:'/pages/chat/index?id='+item.id})}
async function load(){loading.value=true;try{await Promise.all([refreshNotices(),refreshChats(),refreshSocial()])}finally{loading.value=false}}
const fresh=useFreshTask(()=>paneVisible.value,load)

</script>
