{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#a9adaf;font-size:21rpx}.unread{flex-shrink:0;min-width:32rpx;line-height:32rpx;text-align:center;padding:0 7rpx;border-radius:50%;color:#fff;background:var(--brand);font-size:18rpx}.conversation-end{height:16rpx}

