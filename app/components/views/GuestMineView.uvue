<template>
  <view class="screen guest-mine-view" :class="[uxNative?'ux2':'',uxNative?'ux3':'',uxNative?'ux4':'']">
    <scroll-view class="screen-scroll" direction="vertical" :show-scrollbar="false" :class="[uxNative?'ux5':'',uxNative?'ux6':'']">
      <view class="guest-header" :style="uxLayout(uxNodePrefix+'-n0',[],{ paddingTop: statusBarHeight + 'px', height: 'calc(420rpx + ' + statusBarHeight + 'px)' })" :class="[uxNative?'ux2':'',uxNative?'ux7':'']" :id="uxNodePrefix+'-n0'">
        <image class="guest-background" :src="uiAsset(AUTH_ASSETS.guestBackground)" mode="scaleToFill"  :class="[uxNative?'ux8':'']"/>
        <view class="guest-tint"  :class="[uxNative?'ux2':'',uxNative?'ux9':'']"/>
        <view class="guest-body" :class="[uxNative?'ux2':'',uxNative?'ux10':'']">
          <view class="guest-toolbar" :class="[uxNative?'ux2':'',uxNative?'ux11':'']">
            <ActionButton class="icon-button" aria-label="扫一扫" @tap="placeholder('扫一扫')" :class="[uxNative?'ct-native-button':'',uxNative?'ux12':'',uxNative?'ux13':'']" :style="uxLayout(uxNodePrefix+'-g1000',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;16rpx&quot;,&quot;__direction&quot;:&quot;row&quot;,&quot;__padding&quot;:&quot;56rpx&quot;}},{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-g1000'"><AppIcon name="scan" :size="42" tone="white" /></ActionButton>
            <view class="toolbar-spacer"  :class="[uxNative?'ux2':'',uxNative?'ux14':'']" :style="uxLayout(uxNodePrefix+'-g1001',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;16rpx&quot;,&quot;__direction&quot;:&quot;row&quot;,&quot;__padding&quot;:&quot;56rpx&quot;}},{on:true,declarations:{__index:String(0+1)}}],{})" :id="uxNodePrefix+'-g1001'"/>
            <ActionButton class="icon-button" aria-label="设置" @tap="openSettings" :class="[uxNative?'ct-native-button':'',uxNative?'ux12':'',uxNative?'ux13':'']" :style="uxLayout(uxNodePrefix+'-g1002',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;16rpx&quot;,&quot;__direction&quot;:&quot;row&quot;,&quot;__padding&quot;:&quot;56rpx&quot;}},{on:true,declarations:{__index:String(0+1+1)}}],{})" :id="uxNodePrefix+'-g1002'"><AppIcon name="settings" :size="44" tone="white" /></ActionButton>
            <ActionButton class="icon-button" aria-label="个人菜单" @tap="emit('menu')" :class="[uxNative?'ct-native-button':'',uxNative?'ux12':'',uxNative?'ux13':'']" :style="uxLayout(uxNodePrefix+'-g1003',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;16rpx&quot;,&quot;__direction&quot;:&quot;row&quot;,&quot;__padding&quot;:&quot;56rpx&quot;}},{on:true,declarations:{__index:String(0+1+1+1)}}],{})" :id="uxNodePrefix+'-g1003'"><AppIcon name="menu" :size="44" tone="white" /></ActionButton>
          </view>
          <view class="guest-identity" :class="[uxNative?'ux2':'',uxNative?'ux15':'']">
            <ActionButton class="guest-avatar" aria-label="点击登录" @tap="openLogin" :class="[uxNative?'ct-native-button':'',uxNative?'ux12':'',uxNative?'ux16':'']" :style="uxLayout(uxNodePrefix+'-g1004',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;48rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-g1004'"><image :src="uiAsset(AUTH_ASSETS.guestAvatar)" mode="aspectFill"  :class="[uxNative?'ux17':'']"/></ActionButton>
            <ActionButton :aria-label="&quot;点击登录&quot;" class="guest-login" @tap="openLogin" :class="[uxNative?'ct-native-button':'',uxNative?'ux12':'',uxNative?'ux18':'']" :style="uxLayout(uxNodePrefix+'-g1005',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;48rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0+1)}}],{})" :id="uxNodePrefix+'-g1005'"><text :class="[uxNative?'ux19':'',uxNative?'ux20':'',uxNative?'ux21':'']">点击登录</text></ActionButton>
          </view>
          <text class="guest-caption" :class="[uxNative?'ux19':'',uxNative?'ux21':'',uxNative?'ux22':'']">登录解锁更多内容</text>
          <view class="guest-stats" :class="[uxNative?'ux2':'',uxNative?'ux23':'']">
            <ActionButton :aria-label="&quot;0&quot; + ' ' + String(label)" v-for="(label, __uxIndex0) in ['粉丝', '关注', '获赞']" :key="label" @tap="openLogin" :class="[uxNative?'ct-native-button':'',uxNative?'ux12':'',uxNative?'ux24':'']" :style="uxLayout(uxNodePrefix+'-g1006'+'-'+[__uxIndex0].join('-'),[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;25rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0+__uxIndex0)}}],{})" :id="uxNodePrefix+'-g1006'+'-'+[__uxIndex0].join('-')"><!-- #ifdef APP --><NativeStatLabel value="0" :label="label" :label-size="17" label-color="#89b7d7" /><!-- #endif --><!-- #ifndef APP --><text class="guest-stat-value" :class="[uxNative?'ux19':'',uxNative?'ux25':'',uxNative?'ux21':'',uxNative?'ux26':'']" :style="uxLayout(uxNodePrefix+'-g1007'+'-'+[__uxIndex0].join('-'),[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;8rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-g1007'+'-'+[__uxIndex0].join('-')">0</text><text :class="[uxNative?'ux19':'',uxNative?'ux25':'',uxNative?'ux21':'']" :style="uxLayout(uxNodePrefix+'-g1008'+'-'+[__uxIndex0].join('-'),[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;8rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0+1)}}],{})" :id="uxNodePrefix+'-g1008'+'-'+[__uxIndex0].join('-')">{{ label }}</text><!-- #endif --></ActionButton>
          </view>
        </view>
      </view>
      <view class="guest-panel" :class="[{'no-entries':!entries.length},uxNative?'ux2':'',uxNative?'ux30':'',uxNative&amp;&amp;!!!entries.length?'ux37':'']" :style="uxLayout(uxNodePrefix+'-n1',[{on:uxNative,declarations:{&quot;min-height&quot;:&quot;calc(100vh - 564rpx)&quot;}}],{})" :id="uxNodePrefix+'-n1'">
        <MineQuickEntries :entries="entries" guest />
        <ChannelTabs :tabs="mineChannels" :active="activeChannel" searchable @change="activeChannel = String($event.id)" @search="openLogin" />
        <view :key="activeChannel" class="guest-empty" @touchstart="channelSwipe.start" @touchmove="channelSwipe.move" @touchend="channelSwipe.end" @touchcancel="channelSwipe.cancel" :class="[channelDirection,uxNative?'ux2':'',uxNative?'ux36':'',uxNative&amp;&amp;uxClass(channelDirection,&quot;from-right&quot;)?'ux39':'',uxNative&amp;&amp;uxClass(channelDirection,&quot;from-left&quot;)?'ux40':'',uxNative&amp;&amp;uxClass(channelDirection,&quot;from-right&quot;)&amp;&amp;uxMedia(&quot;(prefers-reduced-motion: reduce)&quot;)?'ux41':'',uxNative&amp;&amp;uxClass(channelDirection,&quot;from-left&quot;)&amp;&amp;uxMedia(&quot;(prefers-reduced-motion: reduce)&quot;)?'ux42':'']" :style="uxLayout(uxNodePrefix+'-n2',[],{})" :id="uxNodePrefix+'-n2'">
          <EmptyState flush />
        </view>
