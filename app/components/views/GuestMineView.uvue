/* #endif */

/* #ifndef APP */

.guest-mine-view { background: #fff; }
.guest-header { position: relative; background: #0764b5; }
.guest-background { position: absolute; inset: 0; width: 100%; height: 100%; }
.guest-tint { position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,40,160,.33), rgba(0,145,125,.2)); pointer-events: none; }
.guest-body { position: relative; }
.guest-toolbar { height: 96rpx; padding: 0 28rpx; display: flex; align-items: center; gap: 16rpx; flex-direction: row; }
.toolbar-spacer { flex: 1; }
.guest-identity { display: flex; align-items: center; gap: 48rpx; margin: 29rpx 29rpx 0; height: 103rpx; flex-direction: row; }
.guest-avatar { flex-shrink: 0; width: 103rpx; height: 103rpx; }
.guest-avatar image { display: block; width: 100%; height: 100%; border-radius: 50%; }
.guest-login { color: #fff !important; font-size: 32rpx !important; text-align: left; }
.guest-caption { display: block; margin: 35rpx 29rpx 0; font-size: 21rpx; line-height: 30rpx; color: #fff; }
.guest-stats { display: flex; gap: 25rpx; margin: 24rpx 29rpx 0; flex-direction: row; }
.guest-stats button { display: flex; align-items: baseline; gap: 8rpx; color: #89b7d7; font-size: 17rpx; flex-direction: row; }
.guest-stat-value { font-size: 26rpx; color: #fff; line-height: 32rpx; }
.guest-panel { position: relative; min-height: calc(100vh - 564rpx); margin-top: -28rpx; border-radius: 41.667rpx 41.667rpx 0 0; background: #fff; padding-top: 0; overflow: hidden; }
.guest-panel.no-entries { padding-top: 0; }
.no-entries .guest-channels { margin-top: 0; }
.guest-channels { display: flex; align-items: center; margin-top: 28rpx; padding: 0 29rpx; height: 72rpx; flex-direction: row; }
.guest-channel { position: relative; width: 89rpx; height: 72rpx; flex-shrink: 0; display: flex; align-items: center; font-size: 25rpx; color: #818181; flex-direction: row; }
.guest-channel.selected { color: #272727; font-weight: 600; }
.guest-underline { position: absolute; bottom: 8rpx; left: 4rpx; width: 36rpx; height: 7rpx; border-radius: 5rpx; background: transparent; }
.guest-channel.selected .guest-underline { background: #50cbe5; }
.channel-spacer { flex: 1; }
.guest-search { width: 42rpx; }
.guest-empty { display: flex; flex-direction: column; align-items: center; padding-top: 210rpx; padding-bottom: 80rpx; }
.guest-empty image { display: block; width: 300rpx; height: 215rpx; }
.guest-empty text { margin-top: 30rpx; color: #c5c5c5; font-size: 21rpx; line-height: 30rpx; }
.guest-empty.from-right { animation: guest-channel-from-right 220ms ease-out; }
.guest-empty.from-left { animation: guest-channel-from-left 220ms ease-out; }
@keyframes guest-channel-from-right { from { opacity: .35; transform: translateX(28rpx); } to { opacity: 1; transform: translateX(0); } }
@keyframes guest-channel-from-left { from { opacity: .35; transform: translateX(-28rpx); } to { opacity: 1; transform: translateX(0); } }
@media (prefers-reduced-motion: reduce) {
  .guest-empty.from-right, .guest-empty.from-left { animation: none; }
}

/* #endif */
</style>

