  </view>
</template>
<script setup lang="uts">
import EmptyState from '@/components/EmptyState.uvue'
import { uiAsset } from '@/utils/ui-assets'
import ActionButton from '@/components/ActionButton.uvue'
// #ifdef APP
import NativeStatLabel from '@/components/NativeStatLabel.uvue'
// #endif
import { useHorizontalSwipe } from '@/composables/useHorizontalSwipe'
import { useChannelTransition } from '@/composables/useChannelTransition'
import { useNativeLayout } from '@/composables/useNativeLayout'
const { prefix: uxNodePrefix, style: uxLayout } = useNativeLayout();

import { uxNative, uxClass, uxMedia } from '@/utils/native-styles';

import { ref, watch } from 'vue'
import AppIcon from '@/components/AppIcon.uvue'
import ChannelTabs from '@/components/ChannelTabs.uvue'
import MineQuickEntries from '@/components/MineQuickEntries.uvue'
import { AUTH_ASSETS } from '@/config/assets'
import { mineChannels } from '@/mock/mine'
import type { MineEntry, ViewProps } from '@/types/home.uts'
const props = defineProps<ViewProps & { entries: MineEntry[] }>()
const emit = defineEmits<{ menu: [] }>()
const activeChannel = ref('publish')
const channelSwipe = useHorizontalSwipe(() => props.active, () => activeChannel.value, direction => {
  const index = mineChannels.findIndex(channel => channel.id === activeChannel.value)
  const next = mineChannels[index + direction]
  if (index >= 0 && next) activeChannel.value = String(next.id)
})
const channelDirection = ref('')
const channelTransition = useChannelTransition(() => uxNodePrefix+'-n2', () => props.active)
watch(activeChannel, (next, previous) => {
  channelDirection.value = mineChannels.findIndex(channel => channel.id === next) > mineChannels.findIndex(channel => channel.id === previous) ? 'from-right' : 'from-left'
  void channelTransition.play(channelDirection.value)
})
const openLogin = () => uni.navigateTo({ url: '/pages/login/index' })
const openSettings = () => uni.navigateTo({ url: '/pages/settings/index' })
const placeholder = (title: string) => { if (title === '扫一扫') openScanner() }
import { openScanner } from '@/utils/navigation'
</script>
