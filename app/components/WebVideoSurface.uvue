<template><view :id="hostId" class="web-video-surface"    :class="[uxNative?'ux0':'',uxNative?'ux1':'']"/></template>
<script setup lang="uts">
import { uxNative, uxClass, uxMedia } from '@/utils/native-styles';

import { getCurrentInstance, nextTick, onBeforeUnmount, onMounted, watch } from 'vue'
import { createEngine } from '@/utils/hls-engine.js'
import type { PlaybackOptions, PlaybackEvent } from '@/types/playback'
const props = defineProps<{ options: PlaybackOptions }>()
const emit = defineEmits<{ event: [event: PlaybackEvent] }>()
const hostId = 'ct-web-video-' + getCurrentInstance()!.uid
let engine: ReturnType<typeof createEngine> | undefined
function update() { engine?.update(props.options); if (!props.options.active && props.options.suspendId) emit('event', { suspended: props.options.suspendId }) }
watch(() => props.options, update, { deep: true })
onMounted(async () => { await nextTick(); const host = document.getElementById(hostId); if (host) { engine = createEngine(host, event => emit('event', event)); update() } })
onBeforeUnmount(() => { engine?.destroy(); engine = undefined })
</script>
<style>
/* #ifndef APP */
@import '@/styles/legacy-layout-base.css';
/* #endif */

/* #ifndef APP */



.web-video-surface { position: absolute; top: 0; right: 0; bottom: 0; left: 0; width: 100%; height: 100%; }



/* #endif */
</style>

<style>
/* ct-native-cascade: generated from the original selectors */
/* #ifdef APP */

.ux0{}
.ux1{position:absolute;top:0;right:0;bottom:0;left:0;width:100%;height:100%;}
/* #endif */
</style>
