.player-controls { position: absolute; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 20rpx; min-height: 68rpx; padding: 12rpx 32rpx; background: rgba(0, 0, 0, .58); color: #fff; font-size: 18rpx; flex-direction: row; }
.player-track { position: relative; flex: 1; height: 4rpx; background: #b6b6b6; border-radius: 3rpx; }
.player-elapsed { width: 0; height: 100%; background: var(--brand); }
.player-thumb { position: absolute; top: -6rpx; left: 0; width: 16rpx; height: 16rpx; border-radius: 50%; background: #fff; }
.player-bottom { position: relative; height: 36rpx; }
.minimal-track { position: absolute; bottom: 0; left: 0; right: 0; height: 4rpx; background: #999; }
.minimal-track > view { width: 0; height: 100%; background: var(--brand); }

