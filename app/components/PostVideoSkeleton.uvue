    <view class="player-bottom" :class="[uxNative?'ux0':'',uxNative?'ux14':'']" :style="uxLayout(uxNodePrefix+'-g1006',[{on:true,declarations:{__index:String(0+1)}}],{})" :id="uxNodePrefix+'-g1006'"><view v-if="!controlsVisible" class="minimal-track" :class="[uxNative?'ux0':'',uxNative?'ux15':'']"><view  :class="[uxNative?'ux0':'',uxNative?'ux16':'']"/></view></view>
