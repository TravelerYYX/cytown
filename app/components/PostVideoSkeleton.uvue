<script setup lang="uts">
import { useNativeSemantics } from '@/composables/useNativeSemantics'
const { prefix: a11yPrefix, attrs: a11yAttrs } = useNativeSemantics()
import { useNativeLayout } from '@/composables/useNativeLayout'
const { prefix: uxNodePrefix, style: uxLayout } = useNativeLayout();

import { uxNative, uxClass, uxMedia } from '@/utils/native-styles';

import { ref } from 'vue'
import AppIcon from './AppIcon.uvue'
import MediaSkeleton from './MediaSkeleton.uvue'
import type { MediaSkeletonSpec } from '@/types/home'
import { computed } from 'vue'
import { API_BASE_URL } from '@/config/env'
const props=defineProps<{ media: MediaSkeletonSpec }>()
const source=computed(()=>props.media.url?.startsWith('http')?props.media.url:API_BASE_URL+(props.media.url||''))
const poster=computed(()=>props.media.coverUrl?(props.media.coverUrl.startsWith('http')?props.media.coverUrl:API_BASE_URL+props.media.coverUrl):'')
// Only toggles the two reference UI states; no video element, timer or playback implementation.
const controlsVisible = ref(true)
</script>
