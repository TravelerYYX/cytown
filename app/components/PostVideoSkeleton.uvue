<view :aria-label="&quot;视频播放器 UI 占位&quot;" class="post-video" :class="[media.layout,uxNative?'ux0':'',uxNative?'ux7':'']"  :style="uxLayout(uxNodePrefix+'-n0',[],{})" :id="uxNodePrefix+'-n0'">
<!-- #endif -->
    <view class="video-stage" @tap="controlsVisible = !controlsVisible" :class="[uxNative?'ux0':'',uxNative?'ux8':'']" :style="uxLayout(uxNodePrefix+'-g1000',[{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-g1000'">
      <video v-if="media.url" class="real-video" :src="source" :poster="poster" controls  :class="[uxNative?'ux9':'']" :style="uxLayout(uxNodePrefix+'-n1',[{on:uxNative,declarations:{&quot;aspect-ratio&quot;:&quot;16/9&quot;}}],{})" :id="uxNodePrefix+'-n1'"/>
      <MediaSkeleton v-else :media="media" :controls="false" />
      <view v-if="controlsVisible" class="player-controls" :class="[uxNative?'ux0':'',uxNative?'ux10':'']">
        <AppIcon name="play" tone="white" :size="40"  :style="uxLayout(uxNodePrefix+'-g1001',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;20rpx&quot;,&quot;__direction&quot;:&quot;row&quot;,&quot;__padding&quot;:&quot;64rpx&quot;}},{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-g1001'"/><text :class="[uxNative?'ux17':'',uxNative?'ux20':'',uxNative?'ux21':'']" :style="uxLayout(uxNodePrefix+'-g1002',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;20rpx&quot;,&quot;__direction&quot;:&quot;row&quot;,&quot;__padding&quot;:&quot;64rpx&quot;}},{on:true,declarations:{__index:String(0+1)}}],{})" :id="uxNodePrefix+'-g1002'">00:00</text>
        <view class="player-track" :class="[uxNative?'ux0':'',uxNative?'ux11':'']" :style="uxLayout(uxNodePrefix+'-g1003',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;20rpx&quot;,&quot;__direction&quot;:&quot;row&quot;,&quot;__padding&quot;:&quot;64rpx&quot;}},{on:true,declarations:{__index:String(0+1+1)}}],{})" :id="uxNodePrefix+'-g1003'"><view class="player-elapsed"  :class="[uxNative?'ux0':'',uxNative?'ux12':'']"/><view class="player-thumb"  :class="[uxNative?'ux0':'',uxNative?'ux13':'']"/></view>
        <text :class="[uxNative?'ux17':'',uxNative?'ux20':'',uxNative?'ux21':'']" :style="uxLayout(uxNodePrefix+'-g1004',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;20rpx&quot;,&quot;__direction&quot;:&quot;row&quot;,&quot;__padding&quot;:&quot;64rpx&quot;}},{on:true,declarations:{__index:String(0+1+1+1)}}],{})" :id="uxNodePrefix+'-g1004'">{{ media.duration || '00:00' }}</text><AppIcon name="fullscreen" tone="white" :size="36"  :style="uxLayout(uxNodePrefix+'-g1005',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;20rpx&quot;,&quot;__direction&quot;:&quot;row&quot;,&quot;__padding&quot;:&quot;64rpx&quot;}},{on:true,declarations:{__index:String(0+1+1+1+1)}}],{})" :id="uxNodePrefix+'-g1005'"/>
      </view>
