<template>
  <!-- #ifdef APP -->
  <view v-bind="a11yAttrs(a11yPrefix+'-loading',{'aria-label':'正在加载频道'})" class="feed-loading-placeholder" :class="{'feed-loading-waterfall': waterfall}">
