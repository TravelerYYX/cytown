      <view v-if="waterfall" class="feed-placeholder-title" :class="{'feed-placeholder-waterfall-title':waterfall}" />
      <view v-if="waterfall" class="feed-placeholder-footer"><view class="feed-placeholder-avatar-small" /><view class="feed-placeholder-name" /></view>
      <view v-else class="feed-placeholder-actions"><view class="feed-placeholder-action" /><view class="feed-placeholder-action" /></view>
      <FeedLoadingSheen :card-id="a11yPrefix+'-card-'+index" :waiting="true" />
    </view>
  </view>
</template>
