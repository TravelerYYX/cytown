@import '@/styles/legacy-layout-base.css';
/* #endif */
.viewer-counter-text{color:#fff;font-size:24rpx;}

/* #ifndef APP */

.image-viewer{position:fixed;inset:0;background:#000;z-index:10;overflow:hidden}.viewer-swiper,.zoom-area,.zoom-image{width:100%;height:100%}.full-image{width:100%;height:100%;display:block}.viewer-top{position:absolute;left:32rpx;right:32rpx;display:flex;justify-content:space-between;align-items:center;flex-direction:row}.round,.image-counter{display:flex;align-items:center;justify-content:center;background:rgba(50,50,50,.32);color:white;border-radius:60rpx;width:66rpx;height:66rpx;margin:0;padding:0;flex-direction:row}.image-counter{width:90rpx;height:70rpx;font-size:24rpx}.back,.more{width:68rpx;height:68rpx}.horizontal-more{transform:rotate(90deg)}.viewer-shade{position:absolute;bottom:0;left:0;right:0;height:330rpx;pointer-events:none;background:linear-gradient(transparent,rgba(0,0,0,.48) 56%,#000)}.viewer-footer{position:absolute;bottom:0;left:0;right:0;padding:0 32rpx}.viewer-author{display:flex;align-items:center;gap:0;margin-bottom:58rpx;color:white;flex-direction:row}.avatar{width:58rpx;height:58rpx;border-radius:50%}.viewer-author>text{font-size:24rpx;max-width:42%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.follow{margin:0 0 0 5rpx;background:#0da8fa;color:white;border-radius:17rpx;height:64rpx;min-width:158rpx;font-size:22rpx;padding:0 20rpx;display:flex;align-items:center;justify-content:center;flex-direction:row}.viewer-actions{display:flex;align-items:center;gap:28rpx;min-height:70rpx;flex-direction:row}.comment-input{height:68rpx;flex:1;min-width:0;border-radius:50rpx;background:rgba(255,255,255,.2);padding:0 12rpx;color:#fff;font-size:20rpx;display:flex;align-items:center;justify-content:center;white-space:nowrap;flex-direction:row}.count-action{display:flex;align-items:center;gap:8rpx;color:#fff;padding:0;margin:0;background:transparent;font-size:17rpx;flex-shrink:0;flex-direction:row}.save-icon{padding:0;margin:0;background:transparent;flex-shrink:0}.download-icon{width:40rpx;height:40rpx;display:block}.arrow{width:23rpx;height:23rpx;border-right:3rpx solid #fff;border-bottom:3rpx solid #fff}.arrow.down{transform:translateY(-6rpx) rotate(45deg)}.arrow.up{transform:translateY(6rpx) rotate(225deg)}.expand{position:absolute;left:32rpx}.viewer-back{position:absolute;top:0;left:0;width:100%;height:40rpx;opacity:0;pointer-events:none}.viewer-loading{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);padding:16rpx 24rpx;border-radius:16rpx;background:#0008;color:white;font-size:24rpx;pointer-events:none}button:after{border:none}
.viewer-follow{background:#0da8fa;color:#fff;border-color:#0da8fa;min-width:128rpx}.viewer-follow.selected{background:#ffffff24;color:#fff;border-color:#ffffff80}
@media(max-width:360px){.viewer-actions{gap:16rpx}.viewer-author>text{font-size:22rpx}.count-action{gap:4rpx}}

/* #endif */
</style>

