.ux9{position:absolute;top:0;right:0;bottom:0;left:0;background-color:rgba(0, 0, 0, .56);opacity:0;transition:opacity 220ms ease;}
.ux10{position:absolute;left:0;right:0;bottom:0;min-height:560rpx;border-radius:52rpx 52rpx 0 0;background-color:#f6f7f8;transform:translateY(102%);transition:transform 280ms cubic-bezier(.22, .8, .28, 1);}
.ux11{width:66rpx;height:9rpx;margin:0 auto 72rpx;border-radius:8rpx;background-color:#e3e7eb;}
.ux12{display:flex;flex-direction:column;padding:0 22rpx 118rpx;color:#565b5f;font-size:29rpx;}
