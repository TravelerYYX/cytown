.ux14{width:100%;min-height:106rpx;margin:0;padding:0 38rpx;display:flex;flex-direction:row;align-items:center;justify-content:space-between;border:0px;border-bottom:1rpx solid #f0f1f2;border-radius:0;background-color:#fff;color:#303436;font-size:29rpx;line-height:normal;text-align:left;}






.ux16{border-bottom:0;}
.ux17{opacity:1;}
.ux18{transform:translateY(0);}
