</style>

<style scoped>
/* Shared Web/native profile geometry; home channel tabs retain their layout. */
.profile-geometry { position: relative; height: 76rpx; padding: 0 33.333rpx; border-width: 0; border-radius: 0; }
.profile-tab { flex: none; width: 102.778rpx; height: 64rpx; justify-content: flex-start; flex-shrink: 0; }
.profile-tab-label { margin-left: 1.389rpx; font-size: 26.389rpx; line-height: 40rpx; color: #797d80; font-weight: 400; }
.profile-tab-label-active { color: #252525; font-weight: 600; }
.profile-indicator { position: absolute; left: 38.889rpx; top: 52rpx; width: 41.667rpx; height: 6rpx; pointer-events: none; }
.profile-indicator-bar { width: 41.667rpx; height: 6rpx; border-radius: 3rpx; background-color: #48d5f6; }
.profile-search { align-self: flex-start; margin-top: 10rpx; width: 44.444rpx; height: 44.444rpx; }
.home-tabs-geometry { position: relative; }
.home-tabs-scroll { flex: 1; width: 750rpx; height: 90rpx; }
.home-tabs-track { position: relative; height: 90rpx; display: flex; flex-direction: row; align-items: stretch; }
.home-indicator { top: auto; bottom: 2rpx; width: 34rpx; height: 10rpx; }
.home-indicator-bar { width: 34rpx; height: 10rpx; border-radius: 6rpx; background-color: #13a8f7; }
/* #ifdef WEB */
.profile-indicator { will-change: transform; }
/* #endif */
/* #ifdef MP-WEIXIN */
.profile-indicator { transition: transform 240ms ease-out; }
.profile-indicator-bar.is-moving-a { animation: profile-indicator-contract-a 240ms linear; }
.profile-indicator-bar.is-moving-b { animation: profile-indicator-contract-b 240ms linear; }
@keyframes profile-indicator-contract-a { 0%, 100% { transform: scaleX(1); } 50% { transform: scaleX(.42); } }
@keyframes profile-indicator-contract-b { 0%, 100% { transform: scaleX(1); } 50% { transform: scaleX(.42); } }
@media (prefers-reduced-motion: reduce) {
  .profile-indicator { transition: none; }
  .profile-indicator-bar.is-moving-a, .profile-indicator-bar.is-moving-b { animation: none; }
}
/* #endif */
</style>
