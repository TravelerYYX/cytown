<template>
  <view class="search-header" :style="{ paddingTop: statusBarHeight + 'px' }" :class="[uxNative?'ux0':'',uxNative?'ux1':'']">
    <view class="bar" :class="[uxNative?'ux0':'',uxNative?'ux2':'']">
      <view :id="motionPrefix ? motionPrefix+'-avatar' : uxNodePrefix+'-g1000'" class="search-avatar-motion">
        <ActionButton class="search-avatar" :press-motion="true" :disabled="!interactive" aria-label="用户头像" @tap="openProfile" :class="[uxNative?'ct-native-button':'',uxNative?'ux3':'',uxNative?'ux4':'']"><image class="search-avatar-image" :src="uiAsset(avatarUrl(userInfo))" mode="aspectFill" :class="[uxNative?'ux5':'']" /></ActionButton>
      </view>
      <view :id="motionPrefix ? motionPrefix+'-search' : uxNodePrefix+'-g1001'" class="search-box-motion">
        <ActionButton :aria-label="String(keyword) + ' 搜索'" class="search-box" :press-motion="true" :disabled="!interactive" @tap="openSearch" :class="[uxNative?'ct-native-button':'',uxNative?'ux3':'',uxNative?'ux6':'']">
          <AppIcon name="search" tone="white" :size="34" /><text class="search-keyword" :class="[uxNative?'ux7':'',uxNative?'ux8':'',uxNative?'ux9':'']">{{ keyword }}</text><text class="search-label" :class="[uxNative?'ux7':'',uxNative?'ux8':'',uxNative?'ux10':'']">搜索</text>
        </ActionButton>
      </view>
    </view>
  </view>
</template>
<script setup lang="uts">
import { uiAsset } from '@/utils/ui-assets'
import ActionButton from '@/components/ActionButton.uvue'

import { uxNative, uxClass, uxMedia } from '@/utils/native-styles';

import { getCurrentInstance, ref, watch } from 'vue'
const uxNodePrefix = 'home-search-' + getCurrentInstance()!.uid
import AppIcon from './AppIcon.uvue'
import { openSearchPage } from '@/utils/navigation'
import { authRevision, avatarUrl, getUserInfo, isLoggedIn } from '@/utils/auth'
import type { AppUserInfo } from '@/types/auth'
const props = withDefaults(defineProps<{ statusBarHeight: number; keyword: string; motionPrefix?: string; interactive?: boolean }>(), { motionPrefix: '', interactive: true })
function openSearch() { openSearchPage(props.keyword) }
const userInfo = ref<AppUserInfo | null>(getUserInfo())
const loggedIn = ref(isLoggedIn())
watch(authRevision, () => { userInfo.value = getUserInfo(); loggedIn.value = isLoggedIn() })
function openProfile() { uni.navigateTo({ url: loggedIn.value ? '/pages/profile-edit/index' : '/pages/login/index' }) }
</script>
<style scoped>
