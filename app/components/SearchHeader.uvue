.search-header { position: relative; }
.bar { height: 108rpx; display: flex; align-items: center; padding: 0 34rpx; gap: 24rpx; flex-direction: row; }
.search-avatar { flex-shrink: 0; padding: 0; line-height: 0; }
.search-avatar-image { display: block; width: 62rpx; height: 62rpx; border-radius: 10rpx; }
.search-box { flex: 1; min-width: 0; display: flex; align-items: center; height: 66rpx; border: 2rpx solid rgba(255,255,255,.22); background: rgba(255,255,255,.14); border-radius: 14rpx; padding: 0 22rpx; flex-direction: row; }
.search-keyword { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: left; margin: 0 16rpx; font-size: 24rpx; color: #d8dee5; }
.search-label { color: #fff; padding-left: 24rpx; border-left: 1rpx solid #b8c0cb; font-size: 24rpx; font-weight: 600; }

/* #endif */
</style>

