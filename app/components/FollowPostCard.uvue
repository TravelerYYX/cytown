<template>
  <view class="post-card follow follow-post-card" @tap="openPost">
    <view class="follow-author-row">
      <view class="follow-avatar" @tap.stop="openUserProfile(post.author.id)">
        <UserAvatar navigable :src="post.author.avatar" :user-id="post.author.id" :frame-id="post.author.avatarFrame" :frame-expires-at="post.author.avatarFrameExpiresAt ?? undefined" :size="68" />
        <view v-if="post.author.verify" class="follow-verified"><AppIcon name="check" tone="white" :size="16" /></view>
      </view>
      <view class="follow-author-info">
        <text class="follow-author-name" :max-lines="1">{{ post.author.nickname }}</text>
        <text class="follow-publish-context" :max-lines="1">{{ publishContext }}</text>
      </view>
    </view>
    <view v-if="hasTitle || hasContent" class="follow-copy">
      <text v-if="hasTitle" class="follow-title">{{ post.title }}</text>
      <text v-if="hasContent" class="follow-body" :class="{'follow-body-after-title':hasTitle}" :max-lines="2">{{ post.content }}</text>
    </view>
    <RepostReference v-if="post.repost" :source="post.repost"/>
    <view v-if="layout.cells.length" class="follow-gallery" :style="{width:layout.width+'rpx',height:layout.height+'rpx'}">
      <view v-for="cell in layout.cells" :key="cell.index" class="follow-media-cell" :style="{left:cell.left+'rpx',top:cell.top+'rpx',width:cell.width+'rpx',height:cell.height+'rpx'}" @tap.stop="openPost">
        <CachedImage class="follow-media-image" :src="mediaSource(cell.media)" :version="cell.media.resourceVersion" variant="cover" mode="aspectFill" :priority="loadPriority" @load="onMediaLoad(cell.media, $event)" />
        <FeedVideoLayer v-if="cell.media.type === 'video'" :media="cell.media" :identity="post.id+':'+cell.index" :visible="visible" @open="openPost" @playing="setPlaying(cell.index,$event)" />
        <template v-if="cell.media.type === 'video'">
          <view v-if="!playingMedia.includes(cell.index)" class="follow-play"><image class="follow-play-icon" :src="uiAsset('/static/icons/follow-play.svg')" mode="aspectFit" /></view>
          <text v-if="cell.media.duration" class="follow-video-duration">{{ cell.media.duration }}</text>
        </template>
        <view v-if="cell.index === 2 && layout.remaining > 0" class="follow-more-images"><text class="follow-more-count">+{{ layout.remaining }}</text></view>
      </view>
    </view>
    <scroll-view v-if="post.tags?.length" class="follow-tags" direction="horizontal" :show-scrollbar="false" @tap.stop>
      <view class="follow-tags-row"><view v-for="(tag, index) in post.tags" :key="index" class="follow-tag" :style="{marginLeft:index ? '20.833rpx' : '0rpx'}"><text class="follow-tag-text" :max-lines="1">{{ tag }}</text></view></view>
    </scroll-view>
    <view class="follow-actions">
      <ActionButton class="follow-action" aria-label="分享帖子" @tap.stop="share"><image class="follow-action-icon" :src="uiAsset('/static/icons/follow-share.svg')" mode="aspectFit" /><text class="follow-action-label">转发</text></ActionButton>
      <ActionButton class="follow-action" aria-label="查看评论" @tap.stop="openComments"><image class="follow-action-icon" :src="uiAsset('/static/icons/follow-comment.svg')" mode="aspectFit" /><text class="follow-action-label">{{ post.commentCount ? formatCount(post.commentCount) : '抢首评' }}</text></ActionButton>
      <ActionButton class="follow-action" :aria-label="liked ? '取消点赞' : '点赞'" :aria-pressed="liked" :disabled="likeBusy || post.status === 0" @tap.stop="like">
        <InteractionIcon kind="like" variant="feed" idle-src="/static/icons/follow-like.svg" :active="liked" :play-signal="likePlayback" :enabled="visible" :size="41.667" />
        <text class="follow-action-label" :class="{'follow-action-liked':liked}">{{ formatCount(post.likeCount) || '赞' }}</text>
      </ActionButton>
    </view>
   <PostShareSheet v-if="shareMounted" :visible="shareVisible" :post="post" management @close="shareVisible=false" />
  </view>
</template>
<script setup lang="uts">
import PostShareSheet from './PostShareSheet.uvue'

import FeedVideoLayer from './FeedVideoLayer.uvue'
import RepostReference from './RepostReference.uvue'
import { openUserProfile } from '@/utils/navigation'
import { computed, inject, ref, watch } from 'vue'
import UserAvatar from './UserAvatar.uvue'
import AppIcon from './AppIcon.uvue'
import ActionButton from './ActionButton.uvue'
import CachedImage from './CachedImage.uvue'
import InteractionIcon from './InteractionIcon.uvue'
import { uiAsset } from '@/utils/ui-assets'
import { getFollowMediaLayout, followPublishContext } from '@/utils/follow-layout'
import { rememberMediaRatio } from '@/utils/media-layout'
import { postLayoutKey } from '@/utils/scroll-context'
import { openDestination } from '@/utils/navigation'
import { interactionBusy, performPostInteraction } from '@/utils/interactions'
import type { Post, MediaSkeletonSpec } from '@/types/home'
const props = withDefaults(defineProps<{ post: Post; visible?: boolean; loadPriority?: number }>(), { visible: true, loadPriority: 0 })
const shareMounted=ref(false),shareVisible=ref(false)
function share(){if(props.post.status===0){uni.showToast({title:'审核通过后才可分享',icon:'none'});return}shareMounted.value=true;shareVisible.value=true}
watch(()=>props.post.id,()=>{shareVisible.value=false})
const playingMedia = ref<number[]>([])
function setPlaying(index: number, value: boolean) { playingMedia.value = value ? [...playingMedia.value.filter(item => item !== index), index] : playingMedia.value.filter(item => item !== index) }
watch(() => props.post.id, () => { playingMedia.value = [] })
const hasTitle = computed(() => !!props.post.title?.trim())
const hasContent = computed(() => !!props.post.content?.trim())
const decodedRevision = ref(0)
const layout = computed(() => { void decodedRevision.value; return getFollowMediaLayout(props.post.media) })
const publishContext = computed(() => followPublishContext(props.post))
const invalidateLayout = inject(postLayoutKey, () => {})
const mediaSource = (media: MediaSkeletonSpec) => (media.type === 'video' ? media.coverUrl : media.previewUrl || media.coverUrl || media.url) || ''
function onMediaLoad(media: MediaSkeletonSpec, event: { detail: { width: number; height: number } }) {
  const ratio = event.detail.width / event.detail.height
  if (Number.isFinite(ratio) && ratio > 0) { rememberMediaRatio(media, ratio); decodedRevision.value++; invalidateLayout() }
}
const liked = computed(() => !!props.post.detail?.liked)
const likeBusy = computed(() => interactionBusy.has(props.post.id + ':like'))
const likePlayback = ref(0)
watch(() => props.post.id, () => { likePlayback.value = 0 })
async function like() {
  if (props.post.status === 0) return
  const postId = props.post.id, wasActive = liked.value
  const result = await performPostInteraction(props.post, 'like')
  if (props.post.id === postId && result?.active && !wasActive) likePlayback.value++
}
function openPost() { openDestination({ kind: 'post', title: props.post.title, postId: props.post.id }) }
function openComments() { openDestination({ kind: 'post', title: props.post.title, postId: props.post.id, anchor: 'comments' }) }
const formatCount = (count: number) => count >= 10000 ? (count / 10000).toFixed(count % 10000 === 0 ? 0 : 1) + '万' : count
</script>
<style scoped>
/* #ifndef APP */
@import '@/styles/legacy-layout-base.css';
/* #endif */
.follow-post-card { position: relative; padding: 22rpx 31.944rpx 14rpx; border-bottom: 1.389rpx solid #f5f6f8; background-color: #ffffff; }
.follow-author-row { display: flex; flex-direction: row; align-items: center; height: 92rpx; }
/* Keep the full frame inside the author row's native clipping bounds. */
.follow-avatar { position: relative; width: 92rpx; height: 92rpx; margin-left: 0; flex-shrink: 0; }
.follow-verified { position: absolute; right: 4rpx; bottom: 4rpx; width: 21rpx; height: 21rpx; display: flex; flex-direction: row; justify-content: center; align-items: center; border: 2rpx solid #ffffff; border-radius: 50%; background-color: #f5a349; }
.follow-author-info { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; margin-left: 4rpx; }
.follow-author-name { font-size: 25rpx; line-height: 36rpx; color: #333844; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.follow-publish-context { margin-top: 2rpx; font-size: 19.444rpx; line-height: 29rpx; color: #b1b2b6; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.follow-copy { margin-top: 22rpx; }
.follow-title { display: flex; font-size: 27.778rpx; line-height: 42rpx; font-weight: 500; color: #262d38; }
.follow-body { display: flex; font-size: 24.306rpx; line-height: 38rpx; color: #9a9da3; overflow: hidden; }
.follow-body-after-title { margin-top: 10rpx; }
.follow-gallery { position: relative; margin-top: 24rpx; border-radius: 16.667rpx; overflow: hidden; background-color: #ffffff; }
.follow-media-cell { position: absolute; overflow: hidden; background-color: #eef0f3; }
.follow-media-image { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
.follow-play { position: absolute; left: 50%; top: 50%; width: 90rpx; height: 97.2rpx; margin-left: -45rpx; margin-top: -67rpx; }
.follow-play-icon { width: 100%; height: 100%; }
.follow-video-duration { position: absolute; right: 19rpx; bottom: 15rpx; font-size: 18rpx; line-height: 26rpx; color: #ffffff; }
.follow-more-images { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background-color: rgba(0, 0, 0, .4); display: flex; flex-direction: row; justify-content: center; align-items: center; }
.follow-more-count { font-size: 40rpx; color: #ffffff; }
.follow-tags { margin-top: 22rpx; width: 100%; height: 35rpx; }
.follow-tags-row { display: flex; flex-direction: row; height: 35rpx; }
.follow-tag { flex-shrink: 0; height: 35rpx; padding: 0 20.833rpx; border-radius: 5.556rpx; background-color: #eef0f6; }
.follow-tag-text { font-size: 18.056rpx; line-height: 35rpx; color: #9297a2; white-space: nowrap; }
.follow-actions { display: flex; flex-direction: row; align-items: center; justify-content: space-around; height: 64rpx; margin: 16rpx -31.944rpx 0; }
.follow-action { display: flex; flex-direction: row; align-items: center; justify-content: center; width: 250rpx; height: 64rpx; margin: 0; padding: 0; border-width: 0; border-radius: 0; background-color: transparent; }
.follow-action-icon { flex-shrink: 0; width: 41.667rpx; height: 41.667rpx; }
.follow-action-label { margin-left: 10rpx; font-size: 20.833rpx; line-height: 30rpx; color: #7f8490; }
.follow-action-liked { color: #ff942b; }
/* #ifndef APP */
.follow-body { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.follow-action::after { border: 0; }
/* #endif */
</style>
