.mine-quick-title { display: flex; flex-direction: row; align-items: center; height: 30.556rpx; flex-shrink: 0; }
.mine-quick-icon { width: 30.556rpx; height: 30.556rpx; margin-right: 12.5rpx; flex-shrink: 0; }
