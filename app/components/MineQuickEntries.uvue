<template>
  <view v-if="entries.length" class="mine-quick-zone">
    <scroll-view class="mine-quick-scroll" direction="horizontal" :show-scrollbar="false">
      <view class="mine-quick-track" :style="{width: entries.length * 212.5 + 50 + 'rpx'}">
        <ActionButton v-for="(entry, index) in entries" :key="entry.id" class="mine-quick-entry" :style="{marginRight: index === entries.length - 1 ? '0rpx' : '16.667rpx'}" :aria-label="entry.title" :press-motion="entry.id === -1" @tap="openEntry(entry)">
          <view class="mine-quick-title">
            <image class="mine-quick-icon" :src="uiAsset(entry.id === -1 ? entry.iconUrl : mediaUrl(entry.iconUrl))" mode="aspectFit" />
            <text class="mine-quick-label">{{ entry.title }}</text>
          </view>
          <text class="mine-quick-sub">{{ entry.description }}</text>
        </ActionButton>
      </view>
    </scroll-view>
  </view>
</template>
<script setup lang="uts">
import { uiAsset } from '@/utils/ui-assets'
import ActionButton from '@/components/ActionButton.uvue'
import { mediaUrl } from '@/utils/media-cache'
import { openConfiguredEntry } from '@/utils/navigation'
import type { MineEntry } from '@/types/home'
defineProps<{ entries: MineEntry[]; guest?: boolean }>()
const openEntry = (entry: MineEntry) => openConfiguredEntry(entry.targetType, entry.linkUrl, entry.title, entry.openMode, entry.showTopbar)
</script>
<style scoped>
