.mine-quick-sub { display: flex; margin-top: 3.472rpx; width: 151.389rpx; font-size: 16.667rpx; line-height: 22.222rpx; color: #a2a6a8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
