<template>
  <view class="post-card" :class="[variant,uxNative?'ux1':'',uxNative?'ux8':'',uxNative&amp;&amp;uxClass(variant,&quot;home&quot;)?'ux23':'',uxNative&amp;&amp;uxClass(variant,&quot;mine&quot;)?'ux28':'',variant==='mine'?'mine-reference-card':'']" @tap="open('post', post.title)" :style="uxLayout(uxNodePrefix+'-n0',[],variant==='mine'?mineCardInsets():homeCardInsets())" :id="uxNodePrefix+'-n0'">
    <view v-if="variant === 'mine'" class="date-row" :class="[uxNative?'ux1':'',uxNative?'ux29':'',variant==='mine'?'mine-reference-date-row':'']" :style="uxLayout(uxNodePrefix+'-g1000',[{on:uxNative,declarations:{&quot;__padding&quot;:&quot;68rpx&quot;}},{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-g1000'">
      <view :class="[uxNative?'ux1':'',uxNative?'ux37':'']" :style="uxLayout(uxNodePrefix+'-g1001',[{on:uxNative,declarations:{&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-g1001'"><text v-if="post.pinned" class="profile-pin">置顶</text><text class="date-text" :class="[uxNative?'ux38':'',uxNative?'ux51':'',uxNative?'ux52':'',variant==='mine'?'mine-reference-date-text':'']" :style="uxLayout(uxNodePrefix+'-g1002',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;14rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-g1002'">{{ post.date }}{{ post.game ? ' · ' + post.game : '' }}</text><text v-if="post.status === 0" class="review-state" :class="[uxNative?'ux38':'',uxNative?'ux51':'',uxNative?'ux52':'',uxNative?'ux30':'']" :style="uxLayout(uxNodePrefix+'-g1003',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;14rpx&quot;,&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0+1)}}],{})" :id="uxNodePrefix+'-g1003'">审核中</text></view>
      <ActionButton class="icon-button" aria-label="更多操作" @tap.stop="openMineMenu" :class="[uxNative?'ct-native-button':'',uxNative?'ux53':'',uxNative?'ux3':'',uxNative?'ux18':'',variant==='mine'?'mine-reference-more':'']" :style="uxLayout(uxNodePrefix+'-g1004',[{on:uxNative,declarations:{&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0+1)}}],{})" :id="uxNodePrefix+'-g1004'"><AppIcon name="more" tone="muted" :size="30" /></ActionButton>
    </view>
    <view v-else class="author-row" :class="[uxNative?'ux1':'',uxNative?'ux9':'']" :style="uxLayout(uxNodePrefix+'-g1005',[{on:uxNative,declarations:{&quot;__padding&quot;:&quot;68rpx&quot;}},{on:true,declarations:{__index:String(0+(variant==='mine'?1:0))}}],{})" :id="uxNodePrefix+'-g1005'">
      <FeedRevealBlock kind="author" :ready="avatarReady" :order="0" :enabled="variant === 'home'" style="width:100%">
      <ActionButton class="identity-avatar-button" :class="{'identity-avatar-home':variant==='home'}" :aria-label="post.author.nickname" @tap.stop="openUserProfile(post.author.id)">
        <UserAvatar navigable :src="post.author.avatar" :user-id="post.author.id" :frame-id="post.author.avatarFrame" :frame-expires-at="post.author.avatarFrameExpiresAt ?? undefined" :size="variant === 'home' ? 44 : 56" @load="avatarReady = true" @error="avatarReady = true" />
        <view v-if="post.author.verify" class="identity-verify"><AppIcon name="check" tone="white" :size="17" /></view>
      </ActionButton>
      <view class="identity-author-info" :class="{'identity-author-info-home':variant==='home'}">
        <view class="identity-name-line" @tap.stop="open('post', post.title)"><UserName :user-id="post.author.id" :nickname="post.author.nickname" :level="post.author.level" :size="variant === 'home' ? 19 : 28" /><view v-if="variant === 'home' && post.detail?.following" class="following-chip"><image class="following-chip-icon" :src="uiAsset('/static/icons/feed/following-user.svg')" mode="aspectFit" /><text class="following-chip-text">你的关注</text></view></view>
      </view>
      <ActionButton class="icon-button" aria-label="更多操作" @tap.stop="share" :class="[uxNative?'ct-native-button':'',uxNative?'ux53':'',uxNative?'ux3':'',uxNative?'ux18':'']" :style="uxLayout(uxNodePrefix+'-g1010',[{on:uxNative,declarations:{&quot;__direction&quot;:&quot;row&quot;}},{on:true,declarations:{__index:String(0+1+1)}}],{})" :id="uxNodePrefix+'-g1010'"><AppIcon name="more" tone="muted" :size="28" /></ActionButton>
          </FeedRevealBlock>
    </view>
    <RepostReference v-if="post.repost" :source="post.repost"/>
    <view v-if="variant !== 'home' || hasTitle || hasContent" class="post-copy" :class="[uxNative?'ux1':'',uxNative?'ux19':'',uxNative&amp;&amp;uxClass(variant,&quot;home&quot;)?'ux61':'',uxNative&amp;&amp;uxClass(variant,&quot;mine&quot;)?'ux63':'',variant==='mine'?'mine-reference-copy':'']" :style="uxLayout(uxNodePrefix+'-g1011',[{on:uxNative,declarations:{&quot;__padding&quot;:&quot;68rpx&quot;}},{on:true,declarations:{__index:String(0+(variant==='mine'?1:0)+1)}}],{})" :id="uxNodePrefix+'-g1011'">
      <FeedRevealBlock kind="text" :order="1" :enabled="variant === 'home'" style="width:100%">
      <text v-if="variant !== 'home' || hasTitle" class="post-title" :class="[uxNative?'ux38':'',uxNative?'ux52':'',uxNative?'ux20':'',uxNative&amp;&amp;uxClass(variant,&quot;home&quot;)?'ux64':'',uxNative&amp;&amp;uxClass(variant,&quot;mine&quot;)?'ux66':'',variant==='mine'?'mine-reference-title':'']" :style="uxLayout(uxNodePrefix+'-g1012',[{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-g1012'">{{ post.title }}</text>
      <text v-if="hasContent" class="post-content" :class="[uxNative?'ux38':'',uxNative?'ux52':'',uxNative?'ux21':'',uxNative&amp;&amp;uxClass(variant,&quot;home&quot;)?'ux67':'',uxNative&amp;&amp;uxClass(variant,&quot;mine&quot;)?'ux68':'',uxNative&amp;&amp;uxClass(variant,&quot;home&quot;)?'ux69':'',variant==='mine'?'mine-reference-content':'']" :style="uxLayout(uxNodePrefix+'-g1013',[{on:true,declarations:{__index:String(0+(variant!=='home'||hasTitle?1:0))}}],{})" :id="uxNodePrefix+'-g1013'" :max-lines="(uxNative &amp;&amp; uxClass(variant, &quot;home&quot;)) ? 1 : ((uxNative) ? 2 : (undefined))">{{ post.content }}</text>
          </FeedRevealBlock>
    </view>
    <view v-if="post.media.length" class="media-list" :class="[{'single-media':post.media.length===1},uxNative?'ux1':'',uxNative?'ux22':'',variant==='home'?'home-media-list':'',variant==='mine'?'mine-reference-media':'']" :style="uxLayout(uxNodePrefix+'-g1014',[{on:uxNative,declarations:{&quot;__padding&quot;:&quot;68rpx&quot;}},{on:true,declarations:{__index:String(0+(variant==='mine'?1:0)+1+(variant!=='home'||hasTitle||hasContent?1:0))}}],variant==='home'?{marginTop:'13rpx'}:variant==='mine'?{marginTop:'20.833rpx'}:{})" :id="uxNodePrefix+'-g1014'">
      <view v-for="(media, index) in displayMedia" :key="Number(index)" class="media-slot" :class="[[media.layout,media.type],uxNative?'ux1':'',uxNative&amp;&amp;uxClass([media.layout,media.type],&quot;portrait&quot;)?'ux33':'',uxNative&amp;&amp;uxClass([media.layout,media.type],&quot;square&quot;)?'ux34':'',uxNative&amp;&amp;uxClass([media.layout,media.type],&quot;wide&quot;)?'ux35':'',uxNative&amp;&amp;uxClass(variant,&quot;home&quot;)?'ux70':'',uxNative&amp;&amp;uxClass([media.layout,media.type],&quot;wide&quot;)&amp;&amp;uxClass([media.layout,media.type],&quot;image&quot;)&amp;&amp;!!(post.media.length===1)&amp;&amp;uxClass(variant,&quot;home&quot;)?'ux75':'',uxNative&amp;&amp;uxClass([media.layout,media.type],&quot;wide&quot;)&amp;&amp;uxClass([media.layout,media.type],&quot;video&quot;)&amp;&amp;!!(post.media.length===1)&amp;&amp;uxClass(variant,&quot;home&quot;)?'ux76':'',variant==='mine'?'mine-reference-slot':'']" @tap.stop :style="variant==='mine' ? mineMediaStyle(media,Number(index)) : homeMediaStyle(media,Number(index))" :id="uxNodePrefix+'-n1'+'-'+[Number(index)].join('-')">
        <FeedRevealBlock kind="media" :ready="mediaReady.includes(Number(index)) || !mediaPreviewSource(media)" :order="hasTitle || hasContent ? 2 : 1" :enabled="variant === 'home'">
        <MediaSkeleton :media="media" :autoplay-identity="post.id+':'+index" :visible="visible" :gallery="variant === 'mine' &amp;&amp; post.media.length > 1" :gallery-index="Number(index)" :count-total="variant === 'mine' ? post.media.length : undefined" :count-prefix="variant === 'mine' ? '+ ' : ''" @load="markMediaReady(Number(index))" @error="markMediaReady(Number(index))" :priority="loadPriority" :count="mediaCount(Number(index))" @open="open('post', post.title)"  :style="uxLayout(uxNodePrefix+'-g1015'+'-'+[Number(index)].join('-'),[{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-g1015'+'-'+[Number(index)].join('-')"/>
        </FeedRevealBlock>
      </view>
    </view>
    <view v-if="post.tags?.length" class="tags" :class="[uxNative?'ux1':'',uxNative?'ux31':'',variant==='mine'?'mine-reference-tags':'']" :style="uxLayout(uxNodePrefix+'-g1016',[{on:uxNative,declarations:{&quot;__padding&quot;:&quot;68rpx&quot;}},{on:true,declarations:{__index:String(0+(variant==='mine'?1:0)+1+(variant!=='home'||hasTitle||hasContent?1:0)+(post.media.length?1:0))}}],{})" :id="uxNodePrefix+'-g1016'">
      <text v-for="(tag, __uxIndex0) in post.tags" :key="tag" class="tag" :class="[uxNative?'ux38':'',uxNative?'ux52':'',uxNative?'ux32':'',variant==='mine'?'mine-reference-tag':'']" :style="uxLayout(uxNodePrefix+'-g1017'+'-'+[Number(__uxIndex0)].join('-'),[{on:uxNative,declarations:{&quot;__gap&quot;:variant===&quot;mine&quot;?&quot;20.833rpx&quot;:&quot;10rpx&quot;,&quot;__direction&quot;:&quot;row&quot;,&quot;__wrap&quot;:&quot;wrap&quot;}},{on:true,declarations:{__index:String(0+Number(__uxIndex0))}}],{})" :id="uxNodePrefix+'-g1017'+'-'+[Number(__uxIndex0)].join('-')">{{ tag }}</text>
    </view>
    <view class="actions" :class="[uxNative?'ux1':'',uxNative?'ux24':'',uxNative&amp;&amp;uxClass(variant,&quot;home&quot;)?'ux71':'',uxNative&amp;&amp;uxClass(variant,&quot;mine&quot;)?'ux74':'',variant==='mine'?'mine-reference-actions':'']" :style="uxLayout(uxNodePrefix+'-g1018',[{on:uxNative,declarations:{&quot;__padding&quot;:&quot;68rpx&quot;}},{on:true,declarations:{__index:String(0+(variant==='mine'?1:0)+1+(variant!=='home'||hasTitle||hasContent?1:0)+(post.media.length?1:0)+(post.tags?.length?1:0))}}],variant==='home'?{}:variant==='mine'?{marginLeft:'-31.944rpx',marginRight:'-31.944rpx'}:{marginLeft:'-34rpx',marginRight:'-34rpx'})" :id="uxNodePrefix+'-g1018'">
      <FeedRevealBlock kind="actions" :order="1 + (hasTitle || hasContent ? 1 : 0) + (post.media.length ? 1 : 0)" :enabled="variant === 'home'" style="width:100%">
      <view class="feed-actions-row" :class="{'feed-actions-home':variant==='home'}">
      <ActionButton @tap.stop="share" :aria-label="String(variant === 'mine' ? '分享' : '转发')" v-if="variant !== 'home'" class="action" :style="{flexGrow:1,flexShrink:1,flexBasis:'0px',justifyContent:'center'}" :class="[uxNative?'ct-native-button':'',uxNative?'ux53':'',uxNative?'ux25':'',variant==='mine'?'mine-reference-action':'']" :id="uxNodePrefix+'-g1019'">
        <image v-if="variant==='mine'" class="reference-share-icon" :src="uiAsset('/static/icons/reference-share.svg')" mode="aspectFit" /><AppIcon v-else name="share" tone="muted" :size="variant === 'mine' ? 41.667 : 44"  :id="uxNodePrefix+'-g1020'"/><text class="action-label" :style="uxNative ? {marginLeft:(variant==='home'?4:8)+'rpx',fontSize:(variant==='home'?18:variant==='mine'?20.833:17)+'rpx'} : {}" :class="[uxNative?'ux38':'',uxNative?'ux77':'',uxNative?'ux52':'',variant==='mine'?'mine-reference-action-label':'']" :id="uxNodePrefix+'-g1021'">{{ variant === 'mine' ? '分享' : '转发' }}</text>
      </ActionButton>
      <ActionButton class="action" aria-label="查看评论" :style="variant==='home' ? {} : {flexGrow:1,flexShrink:1,flexBasis:'0px',justifyContent:'center'}" @tap.stop="openComments" :class="[uxNative?'ct-native-button':'',uxNative?'ux53':'',uxNative?'ux25':'',variant==='mine'?'mine-reference-action':'']" :id="uxNodePrefix+'-g1022'">
        <image :style="{width:(variant==='home'?42:variant==='mine'?41.667:44)+'rpx',height:(variant==='home'?42:variant==='mine'?41.667:44)+'rpx'}" class="feed-comment-icon" :src="variant==='mine'?uiAsset('/static/icons/reference-comment.svg'):'/static/images/interactions/feed-comment.png'" mode="aspectFit"  :class="[uxNative?'ux26':'']" :id="uxNodePrefix+'-g1023'"/><text class="action-label" :style="uxNative ? {marginLeft:(variant==='home'?4:8)+'rpx',fontSize:(variant==='home'?18:variant==='mine'?20.833:17)+'rpx'} : {}" :class="[uxNative?'ux38':'',uxNative?'ux77':'',uxNative?'ux52':'',variant==='mine'?'mine-reference-action-label':'']" :id="uxNodePrefix+'-g1024'">{{ post.commentCount ? formatCount(post.commentCount) : '抢首评' }}</text>
      </ActionButton>
      <ActionButton class="action" :style="variant==='home' ? (uxNative ? {marginLeft:'48rpx'} : {}) : {flexGrow:1,flexShrink:1,flexBasis:'0px',justifyContent:'center'}" :class="[uxNative?'ct-native-button':'',{liked},uxNative?'ux53':'',uxNative?'ux25':'',uxNative&amp;&amp;!!liked?'ux36':'',variant==='mine'?'mine-reference-action':'',variant==='mine'&&liked?'mine-reference-action-liked':'']" :aria-label="liked ? '取消点赞' : '点赞'" :disabled="likeBusy || post.status === 0" @tap.stop="like" :id="uxNodePrefix+'-g1025'">
        <InteractionIcon kind="like" variant="feed" :active-src="variant==='mine'?'/static/icons/reference-like-active.svg':undefined" :active="liked" :play-signal="likePlayback" :enabled="visible" :size="variant === 'home' ? 42 : variant === 'mine' ? 41.667 : 44"  :id="uxNodePrefix+'-g1026'"/><text class="action-label" :style="uxNative ? {marginLeft:(variant==='home'?4:8)+'rpx',fontSize:(variant==='home'?18:variant==='mine'?20.833:17)+'rpx'} : {}" :class="[uxNative?'ux38':'',uxNative?'ux77':'',uxNative&amp;&amp;!!liked?'ux95':'',uxNative?'ux52':'',variant==='mine'?'mine-reference-action-label':'',variant==='mine'&&liked?'mine-reference-action-label-liked':'']" :id="uxNodePrefix+'-g1027'">{{ formatCount(post.likeCount) || '赞' }}</text>
      </ActionButton>
                </view>
</FeedRevealBlock>
    </view>
    <FeedLoadingSheen :card-id="uxNodePrefix+'-n0'" :enabled="variant === 'home'" :waiting="!avatarReady || displayMedia.some((media, index) => !!mediaPreviewSource(media) &amp;&amp; !mediaReady.includes(index))" />
  <PostShareSheet v-if="shareMounted" :visible="shareVisible" :post="post" management @close="shareVisible=false" />
  </view>
</template>
<script setup lang="uts">
import PostShareSheet from './PostShareSheet.uvue'

import RepostReference from './RepostReference.uvue'
import { openUserProfile } from '@/utils/navigation'
import FeedLoadingSheen from '@/components/FeedLoadingSheen.uvue'
import FeedRevealBlock from '@/components/FeedRevealBlock.uvue'
import UserAvatar from '@/components/UserAvatar.uvue'
import UserName from '@/components/UserName.uvue'

import LevelBadge from '@/components/LevelBadge.uvue'
import { uiAsset } from '@/utils/ui-assets'
import ActionButton from '@/components/ActionButton.uvue'
import { useNativeLayout } from '@/composables/useNativeLayout'
const { prefix: uxNodePrefix, style: uxLayout } = useNativeLayout();

import { uxNative, uxClass, uxMedia } from '@/utils/native-styles';

import { computed, onBeforeUnmount, ref, watch } from 'vue'
import { observeWindowResize } from '@/utils/window-events'
import InteractionIcon from './InteractionIcon.uvue'
import { interactionBusy, performPostInteraction } from '@/utils/interactions'
import AppIcon from './AppIcon.uvue'
import MediaSkeleton from './MediaSkeleton.uvue'
import { DEFAULT_AVATAR, avatarSrc } from '@/utils/auth'
import { openDestination } from '@/utils/navigation'
import { getFeedMedia, getMineFeedMedia, mediaPreviewSource } from '@/utils/media-layout'
import type { NavigationKind, Post, MediaSkeletonSpec } from '@/types/home'
const props = withDefaults(defineProps<{ managePost?: boolean; post: Post; variant?: 'home' | 'mine'; visible?: boolean; loadPriority?: number }>(), { variant: 'home', visible: true, loadPriority: 0 })
const shareMounted=ref(false),shareVisible=ref(false)
function share(){if(props.post.status===0){uni.showToast({title:'审核通过后才可分享',icon:'none'});return}shareMounted.value=true;shareVisible.value=true}
watch(()=>props.post.id,()=>{shareVisible.value=false})
const avatarReady = ref(false)
const mediaReady = ref<number[]>([])
function markMediaReady(index: number) { if (!mediaReady.value.includes(index)) mediaReady.value.push(index) }
watch(() => props.post.author.avatar, () => { avatarReady.value = false })
watch(() => props.post.media.map(media => [media.url,media.coverUrl,media.previewUrl,media.resourceVersion].join(':')).join('|'), () => { mediaReady.value = [] })
const liked = computed(() => !!props.post.detail?.liked)
const likeBusy = computed(() => interactionBusy.has(props.post.id + ':like'))
const likePlayback = ref(0)
// A native list reuses this component for another post. Never let an earlier
// request completion animate the new occupant of the cell.
watch(() => props.post.id, () => { likePlayback.value = 0 })
async function like() {
  if (props.post.status === 0) return
  const postId = props.post.id
  const wasActive = liked.value
  const result = await performPostInteraction(props.post, 'like')
  if (props.post.id === postId && result?.active && !wasActive) likePlayback.value++
}
function openComments() {
  if (props.post.status === 0) { open('post', props.post.title); return }
  openDestination({ kind: 'post', title: props.post.title, postId: props.post.id, anchor: 'comments' })
}
const hasTitle = computed(() => !!props.post.title?.trim())
const hasContent = computed(() => props.variant === 'home' ? !!props.post.content?.trim() : !!props.post.content)
const avatar = ref(avatarSrc(props.post.author.avatar))
watch(() => props.post.author.avatar, value => { avatar.value = avatarSrc(value) })
const onAvatarError = () => { if (avatar.value !== DEFAULT_AVATAR) avatar.value = DEFAULT_AVATAR }
const feedMedia = computed(() => getFeedMedia(props.post.media))
const emit = defineEmits<{ postMenu: [post: Post] }>()
function openMineMenu() {
  if (props.managePost) emit('postMenu', props.post)
  else share()
}
const mineMediaWidth = (media: MediaSkeletonSpec): number => props.post.media.length > 1 ? 339.583 : media.aspectRatio < 1 ? 430.556 : 686.112

// Align retained native surfaces to the same physical pixel grid. Fractional
// rpx insets/column widths otherwise rasterize one pixel apart per list.
const layoutWindow = ref(uni.getWindowInfo())
const unobserveLayoutPixels = uxNative ? observeWindowResize(() => { layoutWindow.value = uni.getWindowInfo() }) : () => {}
onBeforeUnmount(unobserveLayoutPixels)
function layoutPixelLength(rpx: number): number {
  const info = layoutWindow.value, ratio = info.pixelRatio || 1
  return Math.round(rpx * info.windowWidth / 750 * ratio) / ratio
}
function homeCardInsets() {
  if (!uxNative) return {}
  const inset = layoutPixelLength(34) + 'px'
  return { paddingLeft: inset, paddingRight: inset }
}
function homeMediaStyle(media: MediaSkeletonSpec, index: number) {
  if (!uxNative) return {}
  const info = layoutWindow.value, ratio = info.pixelRatio || 1
  const content = info.windowWidth - 2 * layoutPixelLength(34), gap = layoutPixelLength(10)
  // Size all three previews before native cell measurement. Round down so
  // independently rasterized widths and gaps cannot push the last image out.
  const column = Math.floor(Math.max(0, content - 2 * gap) * ratio / 3) / ratio
  const width = props.post.media.length === 1 && media.layout === 'wide'
    ? Math.min(content, layoutPixelLength(media.type === 'video' ? 450 : 410)) : column
  return { width: width + 'px', marginLeft: (index > 0 ? gap : 0) + 'px', marginTop: '0px' }
}
function mineCardInsets() {
  if (!uxNative) return {}
  const inset = layoutPixelLength(31.944) + 'px'
  return { paddingLeft: inset, paddingRight: inset }
}
function mineMediaStyle(media: MediaSkeletonSpec, index: number) {
  if (!uxNative) return { width: mineMediaWidth(media) + 'rpx', marginLeft: index > 0 ? '6.944rpx' : '0rpx' }
  const info = layoutWindow.value, ratio = info.pixelRatio || 1
  const content = info.windowWidth - 2 * layoutPixelLength(31.944), gap = layoutPixelLength(6.944)
  const width = props.post.media.length > 1 ? Math.floor((content - gap) * ratio / 2) / ratio : media.aspectRatio < 1 ? layoutPixelLength(430.556) : content
  return { width: width + 'px', marginLeft: (index > 0 ? gap : 0) + 'px' }
}

const displayMedia = computed(() => props.variant === 'home' ? feedMedia.value.items : getMineFeedMedia(props.post.media).items)
const mediaCount = (index: number) => props.variant === 'mine' ? (index === 1 && props.post.media.length > 2 ? props.post.media.length - 2 : undefined) : props.variant === 'home' && props.post.media.length > 3 && index === 2 ? props.post.media.length : undefined
const open = (kind: NavigationKind, title: string) => {
  if (props.variant === 'mine' && kind === 'post' && props.post.status === 0) {
    uni.showToast({ title: '内容审核通过后可查看详情', icon: 'none' })
    return
  }
  openDestination({ kind, title, postId: kind === 'post' ? props.post.id : undefined })
}
const formatCount = (count: number) => count >= 10000 ? (count / 10000).toFixed(count % 10000 === 0 ? 0 : 1) + '万' : count
</script>
<style scoped>
/* #ifndef APP */
@import '@/styles/legacy-layout-base.css';
/* #endif */
.post-card { position: relative; }

/* #ifndef APP */

.post-card { background: #fff; padding: 20rpx 34rpx 16rpx; border-bottom: 2rpx solid #f5f5f5; }
.author-row { display: flex; align-items: center; min-height: 54rpx; flex-direction: row; }
.author-avatar { position: relative; flex-shrink: 0; overflow: visible; width: 54rpx; height: 54rpx; padding: 0; margin: 0; line-height: 1; background: transparent; border-radius: 50%; }
.author-avatar::after { border: 0; }
.author-avatar-image { display: block; width: 100%; height: 100%; border-radius: 50%; background: #e6e6e6; }
.verify { position: absolute; bottom: -2rpx; right: -2rpx; border: 3rpx solid #fff; border-radius: 50%; background: #ddd; padding: 2rpx; }
.author-info { flex: 1; min-width: 0; margin-left: 14rpx; }
.name-row { display: flex; align-items: center; min-height: 36rpx; flex-direction: row; }
.author-name { min-width: 0; flex-shrink: 1; color: #999d9f; font-size: 23rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.author-time { display: block; font-size: 19rpx; color: #b9bdbe; margin-top: 5rpx; }
.icon-button { width: 36rpx; height: 44rpx; }
.post-copy { margin-top: 12rpx; }
.post-title { display: block; font-size: 27rpx; line-height: 1.6; color: #272a2b; }
.post-content { display: block; font-size: 25rpx; line-height: 1.8; color: #979b9d; margin-top: 10rpx; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
.media-list { display: flex; gap: 10rpx; flex-wrap: wrap; margin-top: 16rpx; flex-direction: row; }
.media-slot.portrait, .media-slot.square { width: calc((100% - 20rpx) / 3); }
.media-slot.wide { width: 100%; }
.home { padding-top: 16rpx; padding-bottom: 18rpx; }
.home .post-copy { margin-top: 8rpx; }
.home .post-title { font-weight: 600; font-size: 25rpx; line-height: 34rpx; overflow-wrap: anywhere; }
.home .post-content { margin-top: 0; color: #777b7e; font-size: 24rpx; line-height: 34rpx; -webkit-line-clamp: 1; overflow-wrap: anywhere; }
.home .post-title + .post-content { margin-top: 0; }
.home .media-slot { width: calc((100% - 20rpx) / 3); flex-shrink: 0; }
.home .single-media .media-slot.wide.image { width: 410rpx; }
.home .single-media .media-slot.wide.video { width: 450rpx; }
.home .actions { min-height: 44rpx; margin-top: 12rpx; }
.home .media-list { margin-top: 13rpx; }
.home .action { color: #929699; font-size: 18rpx; min-height: 44rpx; gap: 4rpx; }
.actions { display: flex; justify-content: flex-end; align-items: center; gap: 44rpx; min-height: 58rpx; margin-top: 14rpx; flex-direction: row; }
.action { display: flex; align-items: center; gap: 8rpx; color: #a3a7a9; font-size: 21rpx; min-height: 50rpx; flex-direction: row; }
.action.liked { color: #fa9421; }
.feed-comment-icon { display: block; flex-shrink: 0; }
.mine { padding-top: 30rpx; padding-bottom: 20rpx; border-bottom: 14rpx solid #f7f7f7; }
.mine .post-title { font-weight: 600; font-size: 28rpx; }
.mine .actions { justify-content: space-around; gap: 0; margin-top: 20rpx; }
.mine { padding-top: 20rpx; }
.mine .post-title { font-size: 27rpx; }
.mine .post-copy { margin-top: 5rpx; }
.mine .media-list { margin-top: 19rpx; }
.mine .action { font-size: 17rpx; }
.mine .post-content { margin-top: 8rpx; font-size: 24rpx; line-height: 36rpx; }
.date-row { display: flex; align-items: center; justify-content: space-between; color: #a0a4a6; font-size: 20rpx; flex-direction: row; }
.date-row > view { display: flex; align-items: center; gap: 14rpx; flex-direction: row; }
.review-state { padding: 3rpx 10rpx; border-radius: 7rpx; background: #fff4dc; color: #d89016; font-size: 18rpx; }
.tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 15rpx; flex-direction: row; }
.tag { background: #f1f2f3; color: #929799; border-radius: 5rpx; padding: 6rpx 20rpx; font-size: 20rpx; }

/* #endif */
</style>

