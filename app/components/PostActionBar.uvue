<!-- #endif --><HandwrittenCount :count="post.commentCount"  :style="uxLayout(uxNodePrefix+'-g1003',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;8rpx&quot;,&quot;__direction&quot;:&quot;column&quot;}},{on:uxNative&amp;&amp;uxMedia(&quot;(orientation: landscape) and (max-height: 500px)&quot;),declarations:{&quot;__gap&quot;:&quot;0&quot;}},{on:true,declarations:{__index:String(0+1)}}],{})" :id="uxNodePrefix+'-g1003'"/></ActionButton>
      <ActionButton class="detail-action" :aria-pressed="!!post.detail?.liked" :aria-label="post.detail?.liked ? '取消点赞' : '点赞'" :disabled="interactionBusy.has(post.id + ':like') || demo" @tap="toggle('like')" :class="[uxNative?'ct-native-button':'',uxNative?'ux4':'',uxNative?'ux11':'',uxNative&amp;&amp;uxMedia(&quot;(orientation: landscape) and (max-height: 500px)&quot;)?'ux12':'',uxNative?'ux13':'']" :style="uxLayout(uxNodePrefix+'-g1004',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;16rpx&quot;,&quot;__direction&quot;:&quot;row&quot;,&quot;__padding&quot;:&quot;68rpx&quot;}},{on:uxNative&amp;&amp;uxMedia(&quot;(orientation: landscape) and (max-height: 500px)&quot;),declarations:{&quot;__padding&quot;:&quot;40px&quot;}},{on:true,declarations:{__index:String(0+1+1)}}],{})" :id="uxNodePrefix+'-g1004'"><InteractionIcon kind="like" variant="feed" :enabled="visible" :active="!!post.detail?.liked" :play-signal="likePlayback" :size="42"  :style="uxLayout(uxNodePrefix+'-g1005',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;8rpx&quot;,&quot;__direction&quot;:&quot;column&quot;}},{on:uxNative&amp;&amp;uxMedia(&quot;(orientation: landscape) and (max-height: 500px)&quot;),declarations:{&quot;__gap&quot;:&quot;0&quot;}},{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-g1005'"/><HandwrittenCount :count="post.likeCount"  :style="uxLayout(uxNodePrefix+'-g1006',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;8rpx&quot;,&quot;__direction&quot;:&quot;column&quot;}},{on:uxNative&amp;&amp;uxMedia(&quot;(orientation: landscape) and (max-height: 500px)&quot;),declarations:{&quot;__gap&quot;:&quot;0&quot;}},{on:true,declarations:{__index:String(0+1)}}],{})" :id="uxNodePrefix+'-g1006'"/></ActionButton>
      <ActionButton class="detail-action" :aria-pressed="!!post.detail?.favorited" :aria-label="post.detail?.favorited ? '取消收藏' : '收藏'" :disabled="interactionBusy.has(post.id + ':favorite') || demo" @tap="toggle('favorite')" :class="[uxNative?'ct-native-button':'',uxNative?'ux4':'',uxNative?'ux11':'',uxNative&amp;&amp;uxMedia(&quot;(orientation: landscape) and (max-height: 500px)&quot;)?'ux12':'',uxNative?'ux13':'']" :style="uxLayout(uxNodePrefix+'-g1007',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;16rpx&quot;,&quot;__direction&quot;:&quot;row&quot;,&quot;__padding&quot;:&quot;68rpx&quot;}},{on:uxNative&amp;&amp;uxMedia(&quot;(orientation: landscape) and (max-height: 500px)&quot;),declarations:{&quot;__padding&quot;:&quot;40px&quot;}},{on:true,declarations:{__index:String(0+1+1+1)}}],{})" :id="uxNodePrefix+'-g1007'"><InteractionIcon kind="favorite" :enabled="visible" :active="!!post.detail?.favorited" :play-signal="favoritePlayback" :size="42" idle-src="/static/icons/post-actions/favorite.svg"  :style="uxLayout(uxNodePrefix+'-g1008',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;8rpx&quot;,&quot;__direction&quot;:&quot;column&quot;}},{on:uxNative&amp;&amp;uxMedia(&quot;(orientation: landscape) and (max-height: 500px)&quot;),declarations:{&quot;__gap&quot;:&quot;0&quot;}},{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-g1008'"/><HandwrittenCount :count="post.detail?.favoriteCount ?? 0"  :style="uxLayout(uxNodePrefix+'-g1009',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;8rpx&quot;,&quot;__direction&quot;:&quot;column&quot;}},{on:uxNative&amp;&amp;uxMedia(&quot;(orientation: landscape) and (max-height: 500px)&quot;),declarations:{&quot;__gap&quot;:&quot;0&quot;}},{on:true,declarations:{__index:String(0+1)}}],{})" :id="uxNodePrefix+'-g1009'"/></ActionButton>
      <!-- #ifdef APP -->
<view v-bind="a11yAttrs(uxNodePrefix+'-g1010',{&quot;aria-label&quot;:&quot;分享帖子&quot;})" class="detail-action" @tap="share" :class="[uxNative?'ux0':'',uxNative?'ux11':'',uxNative&amp;&amp;uxMedia(&quot;(orientation: landscape) and (max-height: 500px)&quot;)?'ux12':'']" :style="uxLayout(uxNodePrefix+'-g1010',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;16rpx&quot;,&quot;__direction&quot;:&quot;row&quot;,&quot;__padding&quot;:&quot;68rpx&quot;}},{on:uxNative&amp;&amp;uxMedia(&quot;(orientation: landscape) and (max-height: 500px)&quot;),declarations:{&quot;__padding&quot;:&quot;40px&quot;}},{on:true,declarations:{__index:String(0+1+1+1+1)}}],{})" :id="uxNodePrefix+'-g1010'">
<!-- #endif -->
<!-- #ifndef APP -->
<view :aria-label="&quot;分享帖子&quot;" class="detail-action" @tap="share" :class="[uxNative?'ux0':'',uxNative?'ux11':'',uxNative&amp;&amp;uxMedia(&quot;(orientation: landscape) and (max-height: 500px)&quot;)?'ux12':'']" :style="uxLayout(uxNodePrefix+'-g1010',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;16rpx&quot;,&quot;__direction&quot;:&quot;row&quot;,&quot;__padding&quot;:&quot;68rpx&quot;}},{on:uxNative&amp;&amp;uxMedia(&quot;(orientation: landscape) and (max-height: 500px)&quot;),declarations:{&quot;__padding&quot;:&quot;40px&quot;}},{on:true,declarations:{__index:String(0+1+1+1+1)}}],{})" :id="uxNodePrefix+'-g1010'">
<!-- #endif --><!-- #ifdef APP -->
<image @load="a11yImageLoaded(uxNodePrefix+'-g1011')" class="detail-action-icon" :src="uiAsset(&quot;/static/icons/post-actions/share.svg&quot;)" mode="aspectFit"   :class="[uxNative?'ux14':'']" :style="uxLayout(uxNodePrefix+'-g1011',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;8rpx&quot;,&quot;__direction&quot;:&quot;column&quot;}},{on:uxNative&amp;&amp;uxMedia(&quot;(orientation: landscape) and (max-height: 500px)&quot;),declarations:{&quot;__gap&quot;:&quot;0&quot;}},{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-g1011'"/>
<!-- #endif -->
<!-- #ifndef APP -->
<image :aria-hidden="&quot;true&quot;" class="detail-action-icon" :src="uiAsset(&quot;/static/icons/post-actions/share.svg&quot;)" mode="aspectFit"   :class="[uxNative?'ux14':'']" :style="uxLayout(uxNodePrefix+'-g1011',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;8rpx&quot;,&quot;__direction&quot;:&quot;column&quot;}},{on:uxNative&amp;&amp;uxMedia(&quot;(orientation: landscape) and (max-height: 500px)&quot;),declarations:{&quot;__gap&quot;:&quot;0&quot;}},{on:true,declarations:{__index:String(0)}}],{})" :id="uxNodePrefix+'-g1011'"/>
<!-- #endif --><HandwrittenCount :count="post.detail?.shareCount ?? 0"  :style="uxLayout(uxNodePrefix+'-g1012',[{on:uxNative,declarations:{&quot;__gap&quot;:&quot;8rpx&quot;,&quot;__direction&quot;:&quot;column&quot;}},{on:uxNative&amp;&amp;uxMedia(&quot;(orientation: landscape) and (max-height: 500px)&quot;),declarations:{&quot;__gap&quot;:&quot;0&quot;}},{on:true,declarations:{__index:String(0+1)}}],{})" :id="uxNodePrefix+'-g1012'"/></view>
    </view>
  </view>
</template>
<script setup lang="uts">
import { usePaneVisibility } from '@/composables/usePaneVisibility'
import { useNativeSemantics } from '@/composables/useNativeSemantics'
const { prefix: a11yPrefix, attrs: a11yAttrs, refresh: a11yRefresh } = useNativeSemantics()
function a11yImageLoaded(id:string){a11yAttrs(id,{'aria-hidden':true});a11yRefresh(id)}
import { uiAsset } from '@/utils/ui-assets'
import ActionButton from '@/components/ActionButton.uvue'
import { useNativeLayout } from '@/composables/useNativeLayout'
const { prefix: uxNodePrefix, style: uxLayout } = useNativeLayout();

import { uxNative, uxClass, uxMedia } from '@/utils/native-styles';

import HandwrittenCount from './HandwrittenCount.uvue'
import InteractionIcon from './InteractionIcon.uvue'
import { ref } from 'vue'
import { interactionBusy, performPostInteraction, ensureInteractionLogin } from '@/utils/interactions'
import type { InteractionResult } from '@/types/auth'
import type { Post } from '@/types/home'
const props = withDefaults(defineProps<{ post: Post; bottomInset: number; demo?: boolean; active?: boolean }>(), { active: true })
const visible = usePaneVisibility(() => props.active)
const emit = defineEmits<{ (e: 'share'): void; (e: 'comments'): void; (e: 'compose'): void; (e: 'interaction', kind: 'like' | 'favorite', result: InteractionResult): void }>()
function share(){if(!props.demo)emit('share')}
const likePlayback = ref(0), favoritePlayback = ref(0)
async function toggle(kind: 'like' | 'favorite') {
  if (props.demo) return
  const wasActive = kind === 'like' ? !!props.post.detail?.liked : !!props.post.detail?.favorited
  const result = await performPostInteraction(props.post, kind)
  if (!result) return
  emit('interaction', kind, result)
  if (visible.value && result.active && !wasActive) {
    if (kind === 'like') likePlayback.value++
    else favoritePlayback.value++
  }
}
</script>
