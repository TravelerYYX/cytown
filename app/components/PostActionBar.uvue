.comment-input-preview { flex: 1; min-width: 0; height: 72rpx; margin: 0; padding: 0 16rpx; border-radius: 40rpx; background: #f6f7f8; display: flex; align-items: center; justify-content: center; color: #b9bec2; font-size: 20rpx; line-height: 1; white-space: nowrap; flex-direction: row; }
.comment-input-preview::after { border: 0; }
.detail-actions .detail-action { flex-shrink: 0; width: 68rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; min-height: 70rpx; color: #484a4c; }
.detail-action-icon { display: block; width: 42rpx; height: 42rpx; flex-shrink: 0; }
.detail-actions button.detail-action { background: transparent; padding: 0; margin: 0; line-height: inherit; }
.detail-actions button.detail-action::after { border: 0; }
@media (orientation: landscape) and (max-height: 500px) { .detail-actions { min-height: 62px; padding: 6px 20px; } .comment-input-preview { height: 40px; font-size: 14px; } .detail-actions .detail-action { min-height: 44px; gap: 0; } }

/* #endif */
</style>

