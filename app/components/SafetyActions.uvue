<template>
  <view class="safety-host" @tap.stop>
  <view v-if="rendered" class="safety-layer">
    <view class="safety-mask" :style="{opacity:entered?0.60:0}" @tap="close" />
    <view class="safety-sheet" :style="{transform:entered?'translateY(0%)':'translateY(100%)',paddingBottom:bottomPadding+'px'}">
      <text class="safety-title">管理</text>
      <view class="safety-items">
        <ActionButton v-if="showBlock" class="safety-action" :aria-label="blocked?'解除拉黑':'拉黑'" @tap="chooseBlock">
          <view class="safety-circle"><image class="safety-icon" :src="uiAsset('/static/icons/user-block.svg')" mode="aspectFit" /></view>
          <text class="safety-label">{{blocked?'解除拉黑':'拉黑'}}</text>
        </ActionButton>
        <ActionButton v-if="canReport" class="safety-action" aria-label="举报" @tap="chooseReport">
          <view class="safety-circle"><image class="safety-icon" :src="uiAsset('/static/icons/report.svg')" mode="aspectFit" /></view><text class="safety-label">举报</text>
        </ActionButton>
        <ActionButton v-if="saveEnabled" class="safety-action" aria-label="保存" @tap="chooseSave"><view class="safety-circle"><AppIcon name="download" tone="muted" :size="38" /></view><text class="safety-label">保存</text></ActionButton>
      </view>
      <ActionButton class="safety-cancel" aria-label="取消" @tap="close"><text class="safety-cancel-text">取消</text></ActionButton>
    </view>
  </view>
  <SettingsConfirmDialog :visible="dialog" title="温馨提示" :message="blocked?'您确定要解除拉黑吗？':'您确定要拉黑该用户吗？'" @cancel="dialog=false" @confirm="confirmBlock" />
  </view>
</template>
<script setup lang="uts">
import { computed, ref, watch, onBeforeUnmount } from 'vue'
import ActionButton from './ActionButton.uvue'
import AppIcon from './AppIcon.uvue'
import SettingsConfirmDialog from './SettingsConfirmDialog.uvue'
import { usePublishSheetMotion } from '@/composables/usePublishSheetMotion'
import { useWindowInsets } from '@/composables/useWindowInsets'
import { uiAsset } from '@/utils/ui-assets'
import { authRevision, getUserInfo, getSessionGeneration } from '@/utils/auth'
import { ensureInteractionLogin } from '@/utils/interactions'
import { openReport, setUserBlock } from '@/utils/report-api'
const props=withDefaults(defineProps<{visible:boolean;userId:string;postId?:string;showBlock?:boolean;blocked?:boolean;saveEnabled?:boolean}>(),{postId:'',showBlock:false,blocked:false,saveEnabled:false})
const emit=defineEmits<{close:[];changed:[blocked:boolean];save:[]}>()
const dialog=ref(false),busy=ref(false)
const {rendered,entered}=usePublishSheetMotion(()=>props.visible)
const {bottomInset,viewportWidth}=useWindowInsets()
const bottomPadding=computed(()=>Math.max(bottomInset.value,22*viewportWidth.value/750))
const canReport=computed(()=>props.userId!==getUserInfo()?.userId)
let timer:ReturnType<typeof setTimeout>|undefined
function close(){emit('close')}
function afterClose(action:()=>void){close();clearTimeout(timer);timer=setTimeout(action,320)}
function chooseReport(){if(!entered.value)return;const kind=props.postId?'post':'user',target=props.postId||props.userId;afterClose(()=>openReport(kind,target))}
function chooseSave(){if(entered.value)afterClose(()=>emit('save'))}
function chooseBlock(){if(!entered.value||!ensureInteractionLogin())return;afterClose(()=>{dialog.value=true})}
async function confirmBlock(){
  if(busy.value)return
  const session=getSessionGeneration(),target=props.userId,next=!props.blocked
  busy.value=true
  try{await setUserBlock(target,next);if(session!==getSessionGeneration())return;dialog.value=false;emit('changed',next);uni.showToast({title:next?'已拉黑':'已解除拉黑',icon:'none'})}catch{}finally{busy.value=false}
}
watch(authRevision,()=>{clearTimeout(timer);dialog.value=false;close()})
onBackPress(()=>{if(dialog.value){dialog.value=false;return true}if(props.visible){close();return true}return false})
onBeforeUnmount(()=>{clearTimeout(timer)})
</script>
<style scoped>
.safety-layer{position:fixed;top:0;right:0;bottom:0;left:0;z-index:750;}
.safety-mask{position:absolute;top:0;right:0;bottom:0;left:0;background-color:#000;transition-property:opacity;transition-duration:320ms;transition-timing-function:cubic-bezier(.16,1,.3,1);}
.safety-sheet{position:absolute;left:0;right:0;bottom:0;display:flex;flex-direction:column;min-height:370rpx;border-radius:42rpx 42rpx 0 0;background-color:#fff;transition-property:transform;transition-duration:320ms;transition-timing-function:cubic-bezier(.16,1,.3,1);}
.safety-title{margin:31rpx 34rpx 0;font-size:27rpx;line-height:36rpx;color:#283145;font-weight:600;}
.safety-items{display:flex;flex-direction:row;margin:46rpx 29rpx 0;}
.safety-action{display:flex;flex-direction:column;align-items:center;width:86rpx;margin:0 60rpx 0 0;padding:0;border-width:0;background-color:transparent;border-radius:0;}
.safety-circle{display:flex;align-items:center;justify-content:center;width:86rpx;height:86rpx;border-radius:43rpx;background-color:#f5f6fa;}
.safety-icon{width:38rpx;height:38rpx;}
.safety-label{margin-top:12rpx;font-size:22rpx;line-height:30rpx;color:#737987;}
.safety-cancel{display:flex;align-items:center;justify-content:center;height:72rpx;margin:50rpx 0 0;padding:0;border-width:0;border-radius:0;background-color:transparent;}
.safety-cancel-text{font-size:28rpx;line-height:40rpx;font-weight:600;color:#283145;}
/* #ifndef APP */
.safety-layer view,.safety-layer button{box-sizing:border-box;}.safety-action::after,.safety-cancel::after{border:0;}
/* #endif */
</style>
