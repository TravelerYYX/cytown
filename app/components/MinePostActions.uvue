<template>
  <view v-if="rendered || panel" class="post-actions-layer">
    <view class="post-actions-backdrop" :style="{opacity: panel ? .43 : entered ? .6 : 0}" @tap="close" />
    <view v-if="rendered" class="post-actions-sheet"
      :style="{transform: entered ? 'translateY(0%)' : 'translateY(100%)', paddingBottom: bottomPadding + 'px'}">
      <view class="post-actions-handle" />
      <text class="post-actions-heading">帖子快捷操作</text>
      <view class="post-actions-group">
        <ActionButton class="post-actions-row" :aria-label="pinLabel" :disabled="busy || !entered || !canPin" @tap="togglePin">
          <text class="post-actions-label" :class="{'post-actions-disabled': !canPin}">{{ pinLabel }}</text>
        </ActionButton>
        <view class="post-actions-line" />
        <ActionButton class="post-actions-row" aria-label="编辑" :disabled="busy || !entered" @tap="startEdit">
          <text class="post-actions-label">编辑</text>
        </ActionButton>
      </view>
      <view class="post-actions-group post-actions-delete">
        <ActionButton class="post-actions-row" aria-label="删除" :disabled="busy || !entered" @tap="panel = 'delete'">
          <text class="post-actions-label">删除</text>
        </ActionButton>
      </view>
    </view>
    <view v-if="panel" class="post-actions-center" @tap="close">
      <view class="post-actions-dialog" @tap.stop>
        <view v-if="panel === 'delete'" class="post-actions-message post-actions-message-delete">
          <text class="post-actions-label">提示</text>
          <text class="post-actions-description post-actions-delete-description">确认要删除该帖吗</text>
        </view>
        <view v-else-if="panel === 'unpin'" class="post-actions-message">
          <text class="post-actions-label">是否确定取消置顶</text>
        </view>
        <view v-else class="post-actions-edit">
          <text class="post-actions-label">编辑帖子</text>
          <input v-model="title" class="post-actions-input" placeholder="标题" :maxlength="100" />
          <textarea v-model="content" class="post-actions-textarea" placeholder="正文" :maxlength="-1" />
        </view>
        <view class="post-actions-footer">
          <ActionButton class="post-actions-dialog-button" aria-label="取消" :disabled="busy" @tap="close">
            <text class="post-actions-description">取消</text>
          </ActionButton>
          <view class="post-actions-divider" />
          <ActionButton class="post-actions-dialog-button" :aria-label="confirmLabel" :disabled="busy" @tap="confirm">
            <text class="post-actions-confirm" :class="{'post-actions-confirm-delete': panel === 'delete'}">{{ confirmLabel }}</text>
          </ActionButton>
        </view>
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
import { computed, ref, watch } from 'vue'
import ActionButton from '@/components/ActionButton.uvue'
import { usePublishSheetMotion } from '@/composables/usePublishSheetMotion'
import type { Post } from '@/types/home'
import { authRevision, getSessionGeneration } from '@/utils/auth'
import { POST } from '@/utils/request'

const props = defineProps<{ post: Post | null }>()
const emit = defineEmits<{ close: []; changed: [] }>()
const panel = ref('')
const busy = ref(false)
const title = ref('')
const content = ref('')
const { rendered, entered } = usePublishSheetMotion(() => props.post != null && !panel.value)
const canPin = computed(() => props.post?.pinned === true || props.post?.status === 1)
const pinLabel = computed(() => props.post?.pinned ? '取消置顶' : '置顶')
const confirmLabel = computed(() => panel.value === 'edit' ? '保存' : panel.value === 'delete' ? '确认' : '确定')
const bottomPadding = computed(() => {
  const window = uni.getWindowInfo()
  return Math.max(70 * window.windowWidth / 750, (window.safeAreaInsets?.bottom ?? 0) + 24)
})
watch(() => props.post, post => { if (!post) panel.value = '' })
let sessionGeneration = getSessionGeneration()
watch(authRevision, () => {
  const current = getSessionGeneration()
  if (current === sessionGeneration) return
  sessionGeneration = current
  emit('close')
})

function close() {
  if (!busy.value) emit('close')
}
function togglePin() {
  if (props.post?.pinned) panel.value = 'unpin'
  else void mutate('pin', { pinned: true }, '已置顶')
}
function startEdit() {
  const post = props.post
  if (!post) return
  title.value = post.title ?? ''
  content.value = post.content ?? ''
  panel.value = 'edit'
}
function confirm() {
  if (panel.value === 'delete') void mutate('delete', {}, '已删除')
  else if (panel.value === 'unpin') void mutate('pin', { pinned: false }, '已取消置顶')
  else if (panel.value === 'edit') void mutate('edit-text', { title: title.value, content: content.value }, '已保存')
}
async function mutate(action: string, data: Record<string, unknown>, success: string) {
  const post = props.post
  if (!post || busy.value) return
  const session = getSessionGeneration()
  busy.value = true
  try {
    await POST<unknown>('/app/post/' + encodeURIComponent(post.id) + '/' + action, data, true)
    if (session !== getSessionGeneration()) return
    if (props.post?.id === post.id) emit('close')
    emit('changed')
    uni.showToast({ title: success, icon: 'none' })
  } catch (error) {
    if (session === getSessionGeneration()) uni.showToast({ title: error instanceof Error ? error.message : '操作失败，请重试', icon: 'none' })
  } finally {
    busy.value = false
  }
}
</script>

<style scoped>
.post-actions-layer { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 90; }
.post-actions-backdrop { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background-color: #000; transition-property: opacity; transition-duration: 320ms; transition-timing-function: cubic-bezier(.16,1,.3,1); }
.post-actions-sheet { position: absolute; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; padding-top: 16rpx; padding-left: 33rpx; padding-right: 33rpx; border-radius: 42rpx 42rpx 0 0; background-color: #f5f6fa; transition-property: transform; transition-duration: 320ms; transition-timing-function: cubic-bezier(.16,1,.3,1); }
.post-actions-handle { align-self: center; width: 62rpx; height: 8rpx; border-radius: 4rpx; background-color: #e7e8ec; }
.post-actions-heading { margin: 26rpx 18rpx 24rpx; color: #596173; font-size: 24rpx; line-height: 30rpx; }
.post-actions-group { border-radius: 25rpx; overflow: hidden; background-color: #fff; }
.post-actions-delete { margin-top: 25rpx; }
.post-actions-row { display: flex; flex-direction: row; align-items: center; justify-content: flex-start; width: 100%; height: 103rpx; margin: 0; padding: 0 0 0 35rpx; border-width: 0; border-radius: 0; box-sizing: border-box; background-color: transparent; }
.post-actions-line { margin-left: 25rpx; height: 2rpx; background-color: #f0f0f2; }
.post-actions-label { color: #252e41; font-size: 25rpx; }
.post-actions-disabled { color: #9a9eaa; }
.post-actions-center { position: absolute; top: 0; right: 0; bottom: 36rpx; left: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.post-actions-dialog { width: 594rpx; border-radius: 25rpx; overflow: hidden; background-color: #fff; }
.post-actions-message { height: 146rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.post-actions-message-delete { height: 225rpx; }
.post-actions-delete-description { margin-top: 30rpx; }
.post-actions-description { color: #9096a3; font-size: 24rpx; }
.post-actions-footer { height: 100rpx; display: flex; flex-direction: row; align-items: center; background-color: #f5f6fa; }
.post-actions-dialog-button { display: flex; flex-direction: row; align-items: center; justify-content: center; flex: 1; min-width: 0; height: 100rpx; margin: 0; padding: 0; border-width: 0; border-radius: 0; background-color: transparent; }
.post-actions-divider { width: 2rpx; height: 34rpx; background-color: #e7e8ed; }
.post-actions-confirm { color: #00a2f8; font-size: 24rpx; }
.post-actions-confirm-delete { color: #f36b84; }
.post-actions-edit { display: flex; flex-direction: column; padding: 30rpx; }
.post-actions-input, .post-actions-textarea { margin-top: 18rpx; padding: 14rpx; border-radius: 10rpx; background-color: #f5f6fa; color: #252e41; font-size: 24rpx; }
.post-actions-input { height: 60rpx; }
.post-actions-textarea { height: 220rpx; }
/* #ifndef APP */
.post-actions-row::after, .post-actions-dialog-button::after { border: 0; }
/* #endif */
</style>
